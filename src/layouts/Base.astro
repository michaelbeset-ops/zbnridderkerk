---
import '../styles/global.css';
import { site, url } from '../data/site';
import Chrome from '../components/Chrome.astro';
// Fonts vooraf laden, anders verspringt de tekst zodra het lettertype binnenkomt.
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props { title: string; description: string; jsonld?: object | object[]; ogImage?: string; }
const { title, description, jsonld, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Alles van de eigen host; alleen de kaart (Google) en het formulier (FormSubmit) gaan naar buiten.
const csp = "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests";
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.preview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={site.kort} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage ?? url('og.png'), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <meta name="robots" content="max-image-preview:large" />
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0">
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <Chrome deel="kop" />
    <main id="inhoud"><slot /></main>
    <Chrome deel="voet" />
  </body>
</html>
