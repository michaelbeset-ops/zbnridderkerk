---
// Categoriepagina (buitenzonwering en binnenzonwering): korte intro, alle producten als kaart met foto en offerteknop.
// Geen tabbladen of schakelaars: alles staat gewoon in beeld.
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Vlak from '../components/Vlak.astro';
import Afsluiter from '../components/Afsluiter.astro';
import { categorieen, perCategorie, site, url } from '../data/site';
import { fotos } from '../components/Fotos';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return categorieen.map((c) => ({ params: { categorie: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const lijst = perCategorie(c.categorie);
const ander = categorieen.find((x) => x.slug !== c.slug)!;
const beschrijving = `${c.naam} op maat in Ridderkerk: ${lijst.map((p) => p.naam.toLowerCase()).slice(0, 6).join(', ')} en meer. Inmeten en montage door de eigen monteurs van ZBN.`;
const og = (await getImage({ src: fotos[c.foto], width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 })).src;
const jsonld = site.preview ? undefined : {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url(''), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: c.naam, item: new URL(url(`${c.slug}/`), Astro.site).href },
  ],
};
---
<Base title={`${c.naam} op maat in Ridderkerk | ZBN Zonwering`} description={beschrijving} ogImage={og} jsonld={jsonld}>
  <section class="wrap pt-8 lg:pt-14">
    <nav aria-label="Kruimelpad" class="text-sm text-ink-zacht">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={url('')} class="inline-block py-2 underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{c.naam}</li>
      </ol>
    </nav>
    <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="kicker text-ink-zacht">{c.categorie === 'buiten' ? 'Buiten' : 'Binnen'}</p>
        <h1 class="mt-3 text-3xl lg:text-[3.4rem]">{c.naam}</h1>
        <p class="mt-5 max-w-2xl text-lg text-ink-zacht">{c.intro}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:col-span-5 lg:justify-end lg:pb-2">
        <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
        <a href={site.telHref} class="btn btn-wit">Bel <span class="tabular-nums">{site.tel}</span></a>
      </div>
    </div>
  </section>

  <!-- Alle producten van de categorie. Kaart = foto, naam, een regel, en een eigen offerteknop. -->
  <section class="wrap py-12 lg:py-16" aria-labelledby="producten-kop">
    <h2 id="producten-kop" class="sr-only">Producten in {c.naam.toLowerCase()}</h2>
    <ul class="grid gap-x-6 gap-y-10 min-[480px]:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-12">
      {lijst.map((p) => (
        <li class="group relative flex flex-col">
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-ijs">
            {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="(min-width: 1024px) 400px, (min-width: 480px) 50vw, 100vw" class="transition-transform duration-500 group-hover:scale-[1.04]" /> : <Vlak wat={`${p.naam.toLowerCase()}, liggend`} />}
          </div>
          <h3 class="mt-4 flex items-center justify-between gap-3 px-1 text-lg sm:text-xl">
            <a href={url(`producten/${p.slug}/`)} class="min-w-0 break-words no-underline after:absolute after:inset-0 after:rounded-xl">{p.naam}</a>
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-colors group-hover:bg-groen group-hover:text-wit group-hover:ring-groen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </h3>
          <p class="mt-2 flex-1 px-1 text-ink-zacht">{p.kort}</p>
          <p class="mt-4 px-1"><a href={url(`?product=${p.slug}#offerte`)} class="btn btn-lijn relative z-10 !px-4 !py-2 text-sm">Offerte aanvragen</a></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Brede offertebalk en verwijzing naar de andere categorie. -->
  <section class="wrap pb-6 lg:pb-10">
    <div class="grid gap-6 rounded-xl bg-groen p-6 text-wit shadow-kaart md:p-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <h2 class="text-2xl text-wit lg:text-3xl">Weet u nog niet wat past?</h2>
        <p class="mt-3 text-wit/85">Kom langs in de showroom aan de Noordenweg of vraag een offerte aan. We komen inmeten en adviseren wat bij uw woning past.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a href={url('#offerte')} class="btn btn-wit">Offerte aanvragen</a>
        <a href={url('#showroom')} class="btn btn-glas">Showroom</a>
      </div>
    </div>
    <p class="mt-8 text-lg">Ook iets voor {ander.categorie === 'buiten' ? 'buiten' : 'binnen'}? <a href={url(`${ander.slug}/`)} class="font-display font-semibold underline">Bekijk {ander.naam.toLowerCase()}</a></p>
  </section>
  <Afsluiter />
</Base>
