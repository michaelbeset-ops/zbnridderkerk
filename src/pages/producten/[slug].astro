---
// Een sjabloon voor alle productpagina's. De inhoud komt uit src/data/site.ts (basis) en
// src/data/productdetails.ts (voordelen, varianten, bediening, doek, vragen). Mobile-first; het offerteblok plakt op desktop.
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Vlak from '../../components/Vlak.astro';
import Galerij from '../../components/Galerij.astro';
import Icoon from '../../components/Icoon.astro';
import { producten, categorieen, site, url } from '../../data/site';
import { details } from '../../data/productdetails';
import { fotos } from '../../components/Fotos';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return producten.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const d = details[p.slug];
const cat = categorieen.find((c) => c.categorie === p.categorie)!;
const verwant = d.verwant.map((s) => producten.find((x) => x.slug === s)!).filter(Boolean);
const offerte = url(`?product=${p.slug}#offerte`);
const naam = p.naam.toLowerCase();
// Korte meta description (onder 155 tekens) en een eigen deelafbeelding per product.
const beschrijving = `${p.naam} op maat in Ridderkerk. ${p.kort} Inmeten en montage door de eigen monteurs van ZBN.`;
const og = p.foto ? (await getImage({ src: fotos[p.foto], width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 })).src : undefined;
// Gestructureerde data met alleen echte inhoud: kruimelpad en de vragen op deze pagina. Pas als de site op het domein staat.
const jsonld = site.preview ? undefined : [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url(''), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: cat.naam, item: new URL(url(`${cat.slug}/`), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.naam, item: new URL(url(`producten/${p.slug}/`), Astro.site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.vragen.map((v) => ({ '@type': 'Question', name: v.vraag, acceptedAnswer: { '@type': 'Answer', text: v.antwoord } })) },
];
---
<Base title={`${p.naam} op maat in Ridderkerk | ZBN Zonwering`} description={beschrijving} ogImage={og} jsonld={jsonld}>
  <!-- 1. Split hero: tekst links, foto rechts, drie voordeel-labels onder de foto. -->
  <section class="wrap pt-8 lg:pt-14">
    <nav aria-label="Kruimelpad" class="text-sm text-ink-zacht">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={url('')} class="inline-block py-2 underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={url(`${cat.slug}/`)} class="inline-block py-2 underline">{cat.naam}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{p.naam}</li>
      </ol>
    </nav>
    <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10 xl:gap-12">
      <div class="lg:col-span-6 xl:col-span-5">
        <p class="kicker text-ink-zacht">{cat.naam}</p>
        <h1 class="mt-3 text-3xl hyphens-auto lg:text-[3.4rem]" lang="nl">{p.naam}</h1>
        <p class="mt-5 text-lg text-ink-zacht">{p.intro}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={offerte} class="btn btn-groen">Offerte aanvragen</a>
          <a href={site.telHref} class="btn btn-wit">Bel <span class="tabular-nums">{site.tel}</span></a>
        </div>
      </div>
      <div class="lg:col-span-6 xl:col-span-7">
        <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-kaart xl:aspect-[3/2]">
          {p.foto ? <Foto src={fotos[p.foto]} alt={p.fotoAlt ?? ''} hero sizes="(min-width: 1024px) 760px, 100vw" /> : <Vlak wat={`${naam}, hoofdfoto liggend`} />}
        </div>
        <ul class="mt-4 flex flex-wrap gap-2">
          {p.punten.slice(0, 3).map((x) => <li class="inline-flex items-center gap-2 rounded-pill bg-ijs px-3.5 py-1.5 text-sm font-medium ring-1 ring-lijn"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-groen"><path d="M4 12.5l5 5L20 6.5"/></svg>{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Vier voordeelblokken met icoon. -->
  <section class="wrap py-14 lg:py-20" aria-labelledby="voordelen">
    <h2 id="voordelen" class="text-2xl">Waarom {naam}?</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {d.voordelen.map((v) => (
        <li class="rounded-xl bg-ijs p-6">
          <span class="flex h-12 w-12 items-center justify-center rounded-pill bg-wit text-groen ring-1 ring-lijn"><Icoon naam={v.icoon} /></span>
          <h3 class="mt-5 text-lg">{v.kop}</h3>
          <p class="mt-2 text-sm text-ink-zacht">{v.tekst}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="wrap grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <!-- Uitleg -->
      <section class="prose" aria-labelledby="over">
        <h2 id="over" class="text-2xl">Over {naam}</h2>
        {p.tekst.map((t) => <p class="mt-4 text-lg">{t}</p>)}
      </section>

      <!-- 3. Varianten als kaarten. -->
      <section class="mt-14" aria-labelledby="varianten">
        <h2 id="varianten" class="text-2xl">Uitvoeringen</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {d.varianten.map((v) => (
            <li class="rounded-xl bg-wit p-5 ring-1 ring-lijn">
              <h3 class="text-lg">{v.naam}</h3>
              <p class="mt-1.5 text-sm text-ink-zacht">{v.tekst}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- 4. Bedieningsopties. -->
      <section class="mt-14" aria-labelledby="bediening">
        <h2 id="bediening" class="text-2xl">Bediening</h2>
        <ul class="mt-6 divide-y divide-lijn rounded-xl bg-ijs">
          {d.bediening.map((b) => (
            <li class="flex gap-4 px-5 py-4">
              <span class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-pill ${b.beschikbaar ? 'bg-groen text-wit' : 'bg-wit ring-1 ring-lijn'}`}>
                {b.beschikbaar ? <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg> : <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 12h14"/></svg>}
              </span>
              <div>
                <h3 class="text-base font-semibold">{b.naam}{!b.beschikbaar && <span class="ml-2 text-sm font-normal text-ink-zacht">niet van toepassing</span>}</h3>
                <p class="mt-0.5 text-sm text-ink-zacht">{b.tekst}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- 5. Doeken en kleuren. -->
      <section class="mt-14" aria-labelledby="doek">
        <h2 id="doek" class="text-2xl">{d.doek.kop}</h2>
        <p class="mt-4 text-lg text-ink-zacht">{d.doek.tekst}</p>
        <ul class="mt-6 flex flex-wrap gap-3" aria-label="Voorbeeldkleuren">
          {d.doek.stalen.map((s) => (
            <li class="flex items-center gap-2 text-sm"><span class="h-9 w-9 rounded-pill ring-1 ring-lijn" style={`background:${s.kleur}`} aria-hidden="true"></span>{s.naam}</li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-ink-zacht">Voorbeelden; in de showroom aan de Noordenweg ziet u alle stalen in het echt. {d.doek.merken}</p>
        <a href={url('#showroom')} class="btn btn-wit mt-5">Showroom en openingstijden</a>
      </section>
    </div>

    <!-- Offerteblok, plakt op desktop. -->
    <aside class="lg:col-span-4">
      <div class="rounded-xl bg-groen p-6 text-wit shadow-kaart lg:sticky lg:top-28 md:p-8">
        <p class="kicker text-wit/75">Offerte</p>
        <h2 class="mt-2 text-xl text-wit">Offerte voor {naam}</h2>
        <p class="mt-3 text-wit/85">Vrijblijvend. We bellen u voor een afspraak om in te meten en maken daarna een definitieve offerte.</p>
        <a href={offerte} class="btn btn-wit mt-6 w-full">Offerte aanvragen</a>
        <p class="mt-4 text-sm text-wit/80">Liever bellen? <a href={site.telHref} class="font-semibold tabular-nums text-wit underline">{site.tel}</a></p>
        <ul class="mt-6 grid gap-2 border-t border-wit/20 pt-5 text-sm text-wit/90">
          <li class="flex gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M4 12.5l5 5L20 6.5"/></svg>Inmeten aan huis</li>
          <li class="flex gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M4 12.5l5 5L20 6.5"/></svg>Montage door eigen monteurs</li>
          <li class="flex gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M4 12.5l5 5L20 6.5"/></svg>Showroom in Ridderkerk</li>
        </ul>
      </div>
    </aside>
  </div>

  <!-- 6. Fotogalerij met plekken voor foto's. -->
  <div class="mt-14 lg:mt-20"><Galerij naam={p.naam} foto={p.foto} fotoAlt={p.fotoAlt} /></div>

  <!-- 7. Veelgestelde vragen als accordeon. -->
  <section class="wrap py-14 lg:py-20" aria-labelledby="vragen">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="vragen" class="text-2xl">Veelgestelde vragen over {naam}</h2>
        <p class="mt-3 text-ink-zacht">Staat uw vraag er niet bij? Bel <a href={site.telHref} class="font-semibold tabular-nums text-ink underline">{site.tel}</a> of kom langs in de showroom.</p>
      </div>
      <div class="divide-y divide-lijn border-y border-lijn lg:col-span-8">
        {d.vragen.map((v) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {v.vraag}
              <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-transform group-open:rotate-45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
            </summary>
            <p class="pb-5 text-ink-zacht">{v.antwoord}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Brede offertebalk. -->
  <section class="wrap pb-14 lg:pb-20">
    <div class="grid gap-6 rounded-xl bg-groen p-6 text-wit shadow-kaart md:p-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <h2 class="text-2xl text-wit lg:text-3xl">Weten wat {naam} voor uw woning kosten?</h2>
        <p class="mt-3 text-wit/85">Vraag een vrijblijvende offerte aan. We komen inmeten en u ontvangt een definitieve prijs.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a href={offerte} class="btn btn-wit">Offerte aanvragen</a>
        <a href={site.telHref} class="btn btn-glas">Bel <span class="tabular-nums">{site.tel}</span></a>
      </div>
    </div>
  </section>

  <!-- 9. Drie verwante producten. -->
  <section class="wrap pb-16 lg:pb-24" aria-labelledby="verwant">
    <div class="flex items-end justify-between gap-4">
      <h2 id="verwant" class="text-2xl">Ook interessant</h2>
      <a href={url(`${cat.slug}/`)} class="shrink-0 whitespace-nowrap font-display font-semibold underline">Alle {cat.naam.toLowerCase()}</a>
    </div>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {verwant.map((a) => (
        <li class="group">
          <a href={url(`producten/${a.slug}/`)} class="block no-underline">
            <div class="aspect-[4/3] overflow-hidden rounded-xl bg-ijs">
              {a.foto ? <Foto src={fotos[a.foto]} alt="" sizes="(min-width: 640px) 33vw, 100vw" class="transition-transform duration-500 group-hover:scale-[1.03]" /> : <Vlak wat={a.naam.toLowerCase()} />}
            </div>
            <h3 class="mt-4 flex items-center justify-between gap-3 px-1 text-lg"><span>{a.naam}</span><span aria-hidden="true" class="text-ink-zacht transition-transform group-hover:translate-x-1">&rarr;</span></h3>
            <p class="mt-1 px-1 text-sm text-ink-zacht">{a.kort}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
