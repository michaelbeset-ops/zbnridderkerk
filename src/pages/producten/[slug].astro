---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Vlak from '../../components/Vlak.astro';
import Offerte from '../../components/Offerte.astro';
import { producten, site, url } from '../../data/site';
import { fotos } from '../../components/Fotos';

export function getStaticPaths() {
  return producten.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const anderen = producten.filter((x) => x.slug !== p.slug);
---
<Base title={`${p.naam} op maat in Ridderkerk | ZBN`} description={`${p.intro} Inmeten en montage door de eigen monteurs van ZBN Ridderkerk.`}>
  <section class="bg-ecru">
    <div class="wrap py-12 lg:py-20">
      <nav aria-label="Kruimelpad" class="text-sm text-ink-zacht"><a href={url('#producten')} class="underline">Producten</a> <span aria-hidden="true">/</span> <span>{p.naam}</span></nav>
      <div class="mt-6 grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h1 class="text-4xl">{p.naam}</h1>
          <p class="mt-6 max-w-2xl text-lg text-ink-zacht">{p.intro}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="#offerte" class="btn btn-roest">Offerte aanvragen</a>
            <a href={site.telHref} class="font-display font-semibold underline decoration-roest decoration-2 underline-offset-[6px]">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <ul class="text-sm lg:col-span-4 lg:col-start-9 lg:pt-3">
          {p.punten.map((x) => <li class="border-b border-lijn py-2.5 first:border-t">{x}</li>)}
        </ul>
      </div>
    </div>
    <div class="baan h-2" aria-hidden="true"></div>
  </section>

  <section class="wrap py-12 lg:py-16" aria-label={`Foto's van ${p.naam.toLowerCase()}`}>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="aspect-[3/2] overflow-hidden rounded-xl md:col-span-2 md:row-span-2 md:aspect-auto">
        {p.foto ? <Foto src={fotos[p.foto]} alt={p.fotoAlt ?? ''} sizes="(min-width: 1024px) 760px, 100vw" /> : <Vlak wat={`${p.naam.toLowerCase()} 1, liggend`} />}
      </div>
      <div class="aspect-[3/2] overflow-hidden rounded-xl"><Vlak wat={`${p.naam.toLowerCase()} 2`} /></div>
      <div class="aspect-[3/2] overflow-hidden rounded-xl"><Vlak wat={`${p.naam.toLowerCase()} 3`} /></div>
    </div>
  </section>

  <section class="wrap pb-16 lg:pb-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="prose lg:col-span-7">
        <h2 class="text-2xl">Over {p.naam.toLowerCase()}</h2>
        {p.tekst.map((t) => <p class="mt-4 text-lg">{t}</p>)}
        <p class="mt-4 text-lg">Alles maken we op maat. In de showroom aan de Noordenweg ziet u voorbeelden en stalen, en we komen bij u inmeten voordat we een definitieve offerte maken.</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <h2 class="kicker text-ink-zacht">Andere producten</h2>
        <ul class="mt-3">
          {anderen.map((a) => <li class="border-b border-lijn"><a href={url(`producten/${a.slug}/`)} class="block py-2.5 no-underline hover:text-roest">{a.naam}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <Offerte product={p.naam} kop={`Offerte voor ${p.naam.toLowerCase()}`} />
</Base>
