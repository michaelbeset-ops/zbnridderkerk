---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, buiten, binnen, groepen } from '../data/site';
import hero from '../assets/hero.jpg';
import luifel from '../assets/luifel.jpg';
import binnenFoto from '../assets/binnen.jpg';
import knikarm from '../assets/knikarm.jpg';
---
<Base
  title="ZBN Ridderkerk | Zonwering op maat, binnen en buiten"
  description="Zonwerings Bedrijf Noordenweg in Ridderkerk: binnen- en buitenzonwering op maat, bijna alles in eigen bedrijf geassembleerd en gemonteerd door eigen monteurs. Showroom aan de Noordenweg 71a."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Brede terrasfoto onder een groene overlay; de gestreepte doekbaan eronder verwijst naar de valk van een zonnescherm. -->
    <section class="relative overflow-hidden bg-woud text-white">
      <div class="absolute inset-0"><Foto src={hero} alt="Groot uitgeschoven zonnescherm met ingebouwde verlichting boven een terras met tafel, ligbedden en een zwembad, met uitzicht op heuvels" hero sizes="100vw" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-woud-deep/80 lg:bg-transparent lg:bg-gradient-to-r lg:from-woud-deep lg:via-woud-deep/85 lg:to-woud-deep/10"></div>
      <div class="wrap relative py-16 lg:py-28">
        <div class="max-w-2xl">
          <p class="font-display text-sm font-medium uppercase tracking-[0.14em] text-mint">Binnen- en buitenzonwering, Ridderkerk</p>
          <h1 class="mt-4 text-4xl">Zonwering op maat, bijna alles zelf geassembleerd</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">ZBN levert uitsluitend kwalitatief hoogwaardige producten, met een lange levensduur. In overleg met u zorgen we voor een passende oplossing, voor bedrijven en particulieren.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={site.telHref} class="btn btn-roest">Bel voor een afspraak aan huis</a>
            <a href="#showroom" class="font-display font-semibold underline decoration-mint decoration-2 underline-offset-[6px]">Kom langs in de showroom</a>
          </div>
          <dl class="mt-10 grid max-w-xl grid-cols-1 gap-4 border-t border-white/25 pt-6 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-white/80">Showroom</dt>
              <dd class="font-semibold" data-vandaag>Di t/m vr <span class="whitespace-nowrap tabular-nums">8.30 tot 16.30</span> uur</dd>
            </div>
            <div>
              <dt class="text-white/80">Google</dt>
              <dd class="font-semibold"><span class="tabular-nums">{site.google.score}</span> uit 5, {site.google.aantal} reviews</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="baan relative h-3" aria-hidden="true"></div>
    </section>

    <section id="assortiment" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-12">
        <h2 class="text-3xl lg:col-span-5">Voor binnen en buiten, alles op maat</h2>
        <p class="text-lg text-ink-soft lg:col-span-6 lg:col-start-7 lg:pt-2">U kunt bij ons terecht voor al uw binnen- en buitenzonwering. Omdat we maatwerk leveren, zoeken we samen met u de oplossing die past. Alles wat we leveren, kunt u in de showroom bekijken.</p>
      </div>
      <div class="mt-14 grid gap-14 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <div class="aspect-[3/2] overflow-hidden rounded-xl"><Foto src={luifel} alt="Rood-wit gestreepte markies boven een raam in een gele houten gevel, met bloembakken onder het raam" sizes="(min-width: 1216px) 660px, (min-width: 1024px) 56vw, 100vw" /></div>
          <div class="mt-8 flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3">
            <h3 class="text-2xl">Buiten</h3>
            <span class="text-sm text-ink-soft">onder andere</span>
          </div>
          <ul class="grid min-[400px]:grid-cols-2 min-[400px]:gap-x-6 sm:gap-x-8">
            {buiten.map((p) => <li class="border-b border-line py-3">{p}</li>)}
          </ul>
        </div>
        <div class="lg:col-span-5 lg:mt-32">
          <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={binnenFoto} alt="Lichte bank met kussens voor een erker met witte jaloezieën en gordijnen" sizes="(min-width: 1216px) 460px, (min-width: 1024px) 40vw, 100vw" /></div>
          <div class="mt-8 flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3">
            <h3 class="text-2xl">Binnen</h3>
            <span class="text-sm text-ink-soft">onder andere</span>
          </div>
          <ul class="grid min-[400px]:grid-cols-2 min-[400px]:gap-x-6 sm:gap-x-8">
            {binnen.map((p) => <li class="border-b border-line py-3">{p}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="werkwijze" class="scroll-mt-20 bg-woud py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Van showroom tot montage, in eigen hand</h2>
          <div class="mt-10 hidden aspect-[4/5] overflow-hidden rounded-xl lg:block"><Foto src={knikarm} alt="Grote lichte overkapping tegen een blauwe lucht, met een palmboom en struiken ervoor" sizes="440px" /></div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ol class="border-l-2 border-mint/40">
            <li class="relative pb-10 pl-8">
              <span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full bg-roest" aria-hidden="true"></span>
              <p class="font-display text-sm font-medium uppercase tracking-[0.14em] text-mint">Advies</p>
              <h3 class="mt-2 text-xl">In de showroom of bij u thuis</h3>
              <p class="mt-3 text-white/85">In de showroom bekijkt u de producten en geeft een van onze medewerkers u graag deskundig advies. Of we maken een afspraak voor een bezoek aan uw woning of bedrijf.</p>
            </li>
            <li class="relative pb-10 pl-8">
              <span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full bg-roest" aria-hidden="true"></span>
              <p class="font-display text-sm font-medium uppercase tracking-[0.14em] text-mint">Maatwerk</p>
              <h3 class="mt-2 text-xl">Bijna alles zelf geassembleerd</h3>
              <p class="mt-3 text-white/85">We leveren maatwerk. Bijna alle producten worden in ons eigen bedrijf aan de Noordenweg geassembleerd.</p>
            </li>
            <li class="relative pl-8">
              <span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full bg-roest" aria-hidden="true"></span>
              <p class="font-display text-sm font-medium uppercase tracking-[0.14em] text-mint">Montage</p>
              <h3 class="mt-2 text-xl">Door onze eigen monteurs</h3>
              <p class="mt-3 text-white/85">Onze eigen deskundige monteurs zorgen ervoor dat uw aankoop op de voorgeschreven wijze wordt gemonteerd.</p>
            </li>
          </ol>
          <div class="mt-12 rounded-xl bg-woud-deep p-6 md:p-8">
            <h3 class="text-xl">Reparatie en onderhoud</h3>
            <p class="mt-3 text-white/85">Ook voor reparatie en onderhoud kunt u bij ons terecht.</p>
            <a href={site.telHref} class="btn btn-roest mt-6">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <div class="mt-10 aspect-[3/2] overflow-hidden rounded-xl lg:hidden"><Foto src={knikarm} alt="Grote lichte overkapping tegen een blauwe lucht, met een palmboom en struiken ervoor" sizes="100vw" /></div>
        </div>
      </div>
    </section>

    <section aria-labelledby="merken-kop" class="bg-ecru">
      <div class="wrap grid gap-4 py-12 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-3">
          <div class="baan-woud mb-4 h-2 w-16 rounded-full" aria-hidden="true"></div>
          <h2 id="merken-kop" class="font-display text-sm font-medium uppercase tracking-[0.14em] text-ink-soft">Merken die we leveren</h2>
        </div>
        <p class="font-display text-xl font-medium leading-snug tracking-[-0.02em] lg:col-span-9 lg:text-2xl">Zonwerings- en screendoek van Swela, Dickson, Tibelly en Sattler. Motoren en toebehoren van Geiger en Somfy. Raamdecoratie van Velux.</p>
      </div>
    </section>

    <section id="showroom" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">De showroom aan de Noordenweg</h2>
          <p class="mt-6 text-lg text-ink-soft">Alle producten die ZBN levert, kunt u hier bekijken. Een van onze medewerkers geeft u graag deskundig advies, of maakt een afspraak voor een bezoek aan uw woning of bedrijf.</p>
          <address class="mt-8 text-lg not-italic">{site.naam} vof<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
          <dl class="mt-10 grid gap-4">
            <div><dt class="text-sm text-ink-soft">Telefoon</dt><dd><a href={site.telHref} class="font-display text-2xl font-semibold whitespace-nowrap tabular-nums underline decoration-roest decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all text-lg underline decoration-roest decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8">
            <h3 class="text-xl">Openingstijden showroom</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden van de showroom</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr class="border-b border-line last:border-0" data-dag={t.dag}>
                    <th scope="row" class="py-3 pr-4 font-medium">{t.naam}</th>
                    <td class="py-3 text-right whitespace-nowrap tabular-nums">{t.open ? `${t.open} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="offerte" class="scroll-mt-20 bg-doek py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Offerte of afspraak aan huis</h2>
          <p class="mt-6 text-lg">Vertel ons wat u zoekt. We nemen contact met u op om de mogelijkheden te bespreken of een bezoek aan uw woning of bedrijf te plannen.</p>
          <p class="mt-6 text-ink-soft">Liever direct iemand spreken? Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums font-semibold text-ink underline decoration-roest decoration-2 underline-offset-4">{site.tel}</a>.</p>
        </div>
        <form class="rounded-xl bg-white p-6 shadow-sm md:p-10 lg:col-span-8" onsubmit="return false">
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2"><label for="naam" class="text-sm font-medium">Naam</label><input id="naam" name="naam" autocomplete="name" class="veld mt-1.5" /></div>
            <div><label for="tel" class="text-sm font-medium">Telefoon</label><input id="tel" name="telefoon" type="tel" autocomplete="tel" class="veld mt-1.5" /></div>
            <div><label for="mail" class="text-sm font-medium">E-mail</label><input id="mail" name="email" type="email" autocomplete="email" class="veld mt-1.5" /></div>
            <div class="sm:col-span-2">
              <label for="product" class="text-sm font-medium">Waar gaat het om?</label>
              <select id="product" name="product" class="veld mt-1.5">
                <option value="">Kies een product</option>
                {groepen.map((g) => <option>{g}</option>)}
              </select>
            </div>
            <div class="sm:col-span-2"><label for="bericht" class="text-sm font-medium">Bericht</label><textarea id="bericht" name="bericht" rows="4" class="veld mt-1.5"></textarea></div>
          </div>
          {site.voorstel ? (
            <p class="mt-6 border-l-4 border-roest bg-ecru px-4 py-3 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-semibold underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-woud mt-6">Verstuur aanvraag</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
  <script>
    // Markeer vandaag in de openingstijden en toon in de hero de tijden van vandaag (Nederlandse tijd).
    const naam = new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'Europe/Amsterdam' }).format(new Date());
    const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(naam);
    const rij = document.querySelector<HTMLElement>(`tr[data-dag="${dag}"]`);
    if (rij) {
      rij.classList.add('text-roest', 'font-semibold');
      const tijd = rij.querySelector('td')?.textContent ?? '';
      const el = document.querySelector('[data-vandaag]');
      let tekst = `Vandaag <span class="whitespace-nowrap tabular-nums">${tijd}</span>`;
      if (tijd === 'Gesloten') {
        const volgende = document.querySelector(`tr[data-dag="${(dag + 1) % 7}"]`);
        const dagnaam = volgende?.querySelector('th')?.textContent?.toLowerCase() ?? '';
        const vanaf = volgende?.querySelector('td')?.textContent?.split(' ')[0] ?? '';
        tekst = `Vandaag gesloten, ${dagnaam} vanaf <span class="whitespace-nowrap tabular-nums">${vanaf}</span> uur`;
      }
      if (el) el.innerHTML = tekst;
    }
  </script>
</Base>
