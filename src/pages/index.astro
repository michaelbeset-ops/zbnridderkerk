---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Producten from '../components/Producten.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Showroom from '../components/Showroom.astro';
import Reviews from '../components/Reviews.astro';
import Offerte from '../components/Offerte.astro';
import Afsluiter from '../components/Afsluiter.astro';
import Vandaag from '../components/Vandaag.astro';
import { site, tijden, url, categorieen, perCategorie } from '../data/site';

// JSON-LD LocalBusiness met alleen de echte gegevens. Pas opnemen als de site op het eigen domein staat.
const dagen = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonld = site.preview ? undefined : [{
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL(url('#website'), Astro.site).href,
  name: site.handelsnaam, alternateName: [site.kort, site.naam], url: new URL(url(''), Astro.site).href, inLanguage: 'nl-NL',
}, {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', '@id': new URL(url('#bedrijf'), Astro.site).href,
  name: site.handelsnaam, legalName: `${site.naam} ${site.rechtsvorm}`, alternateName: [site.kort, site.naam], telephone: '+31180430211', email: site.mail,
  url: new URL(url(''), Astro.site).href, image: new URL(url('og.jpg'), Astro.site).href,
  areaServed: site.werkgebied.map((name) => ({ '@type': 'City', name })),
  address: { '@type': 'PostalAddress', streetAddress: site.straat, postalCode: site.postcode, addressLocality: site.plaats, addressCountry: 'NL' },
  // Coördinaten van de pin en de link naar het Google Bedrijfsprofiel (opgehaald 2 nov 2026).
  geo: { '@type': 'GeoCoordinates', latitude: 51.8724936, longitude: 4.6035895 },
  hasMap: site.gbp, sameAs: [site.gbp],
  description: 'Zonweringsbedrijf in Ridderkerk met eigen showroom: buiten- en binnenzonwering, rolluiken, garagedeuren en overkappingen op maat, ingemeten en gemonteerd door eigen monteurs.',
  identifier: { '@type': 'PropertyValue', propertyID: 'KvK', value: site.kvk },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Producten', itemListElement: categorieen.map((c) => ({ '@type': 'OfferCatalog', name: c.naam, itemListElement: perCategorie(c.categorie).map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p.naam, url: new URL(url(`producten/${p.slug}/`), Astro.site).href } })) })) },
  openingHoursSpecification: tijden.filter((t) => t.open).map((t) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dagen[t.dag], opens: t.open.split(' tot ')[0].replace('.', ':').padStart(5, '0'), closes: t.open.split(' tot ')[1].replace('.', ':') })),
}];
---
<Base
  title="ZBN Zonwering Ridderkerk | Zonwering en rolluiken op maat"
  description="Zonweringsbedrijf in Ridderkerk met eigen showroom aan de Noordenweg 71a. Zonwering, screens, rolluiken en overkappingen op maat, door eigen monteurs geplaatst."
  jsonld={jsonld}
>
  <Hero />
  <Producten />
  <Werkwijze />
  <Showroom />
  <Reviews />
  <Offerte />
  <Afsluiter />
  <Vandaag />
</Base>
