---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Producten from '../components/Producten.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Showroom from '../components/Showroom.astro';
import Reviews from '../components/Reviews.astro';
import Offerte from '../components/Offerte.astro';
import Afsluiter from '../components/Afsluiter.astro';
import Vandaag from '../components/Vandaag.astro';
import { site, tijden, url } from '../data/site';

// JSON-LD LocalBusiness met alleen de echte gegevens. Pas opnemen als de site op het eigen domein staat.
const dagen = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonld = site.preview ? undefined : {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: `${site.naam} ${site.rechtsvorm}`, alternateName: site.kort, telephone: '+31180430211', email: site.mail,
  url: new URL(url(''), Astro.site).href, image: new URL(url('og.png'), Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: site.straat, postalCode: site.postcode, addressLocality: site.plaats, addressCountry: 'NL' },
  openingHoursSpecification: tijden.filter((t) => t.open).map((t) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dagen[t.dag], opens: t.open.split(' tot ')[0].replace('.', ':').padStart(5, '0'), closes: t.open.split(' tot ')[1].replace('.', ':') })),
};
---
<Base
  title="ZBN Zonwering Ridderkerk | Zonwering en rolluiken op maat"
  description="Zonweringsbedrijf Noordenweg in Ridderkerk: binnen- en buitenzonwering, rolluiken, garagedeuren en terrasoverkappingen op maat, met eigen montage en showroom aan de Noordenweg 71a."
  jsonld={jsonld}
>
  <Hero />
  <Producten />
  <Werkwijze />
  <Showroom />
  <Reviews />
  <Offerte />
  <Afsluiter />
  <Vandaag />
</Base>
