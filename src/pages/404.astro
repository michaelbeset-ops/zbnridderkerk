---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---
<Base title="Pagina niet gevonden | ZBN Ridderkerk" description="Deze pagina bestaat niet.">
  <section class="wrap py-20 lg:py-32">
    <div class="max-w-xl">
      <h1 class="text-4xl">Deze pagina bestaat niet</h1>
      <p class="mt-6 text-lg text-ink-zacht">Het adres klopt niet meer of is verkeerd getypt.</p>
      <a href={url('')} class="btn btn-groen mt-8">Naar de homepage</a>
    </div>
  </section>
</Base>

<script>
  // Vangnet voor adressen van de oude site (bijv. /home/index.php/rolluiken): op trefwoord naar de nieuwe pagina,
  // anders naar de homepage. Alleen voor paden die op de oude site leken; echte typfouten blijven op deze 404.
  const pad = decodeURIComponent(location.pathname.toLowerCase());
  if (/\/home\/|index\.php|\.html?$|\.php/.test(pad)) {
    const doelen: [RegExp, string][] = [
      [/knikarm|zonnescherm/, 'producten/knikarmschermen/'], [/uitval/, 'producten/uitvalschermen/'], [/rolluik/, 'producten/rolluiken/'],
      [/zip/, 'producten/zipscreens/'], [/screen/, 'producten/screens/'], [/serre/, 'producten/serrezonwering/'], [/pergola/, 'producten/pergolazonwering/'],
      [/rolpoort/, 'producten/rolpoorten/'], [/garage/, 'producten/garagedeuren/'], [/overkap|terras/, 'producten/overkappingen/'], [/markiez|markies/, 'producten/markiezen/'],
      [/motor|somfy/, 'producten/motoren/'], [/jaloez/, 'producten/jaloezieen/'], [/duo/, 'producten/duo-rolgordijnen/'], [/rolgordijn/, 'producten/rolgordijnen/'],
      [/pliss/, 'producten/plissegordijnen/'], [/lamel/, 'producten/lamelgordijnen/'], [/shutter/, 'producten/shutters/'], [/hordeur/, 'producten/hordeuren/'],
      [/hor/, 'producten/horren/'], [/velux/, 'producten/dakramen-velux/'], [/fakro/, 'producten/dakramen-fakro/'], [/binnen/, 'binnenzonwering/'],
      [/buiten|zonwering/, 'buitenzonwering/'], [/contact|route|openingstijd/, '#showroom'],
    ];
    const doel = doelen.find(([r]) => r.test(pad))?.[1] ?? '';
    location.replace('/' + doel);
  }
</script>

