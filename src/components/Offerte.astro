---
// Offerteformulier als kaart in de merkkleur: links de uitleg, rechts het formulier.
// Verzenden via Web3Forms (AJAX), met inline foutmeldingen, bevestiging en een honeypot. Bijlagen kunnen niet met het gratis
// abonnement van Web3Forms; foto's mailt de klant los naar info@.
// De access key komt uit PUBLIC_WEB3FORMS_KEY; zonder key blijft het formulier zichtbaar maar verstuurt het niets.
import { site, url, offerteOpties, producten } from '../data/site';
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const slugs = Object.fromEntries(producten.map((p) => [p.slug, p.naam]));
---
<section id="offerte" class="wrap scroll-mt-24 py-16 lg:py-24">
  <div class="grid overflow-hidden rounded-xl bg-groen text-wit shadow-kaart lg:grid-cols-12">
    <div class="p-6 md:p-10 lg:col-span-5 lg:p-14">
      <p class="kicker text-wit/75">Offerte aanvragen</p>
      <h2 class="mt-3 text-3xl text-wit">Vertel ons wat u zoekt.</h2>
      <p class="mt-5 text-lg text-wit/90">Vrijblijvend en zonder verplichtingen. Heeft u een foto van de gevel, het raam of het terras? Mail die gerust na; dan hebben we direct een goed beeld.</p>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-wit/90">
        <li class="flex items-center gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>Reactie binnen enkele werkdagen</li>
        <li class="flex items-center gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>Inmeten aan huis</li>
        <li class="flex items-center gap-2"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>Geen verplichtingen</li>
      </ul>
      <ol class="mt-8 grid gap-4 text-wit/90">
        <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-pill bg-wit/15 font-display text-sm font-bold">1</span>U verstuurt het formulier, wij ontvangen het direct.</li>
        <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-pill bg-wit/15 font-display text-sm font-bold">2</span>We bellen of mailen u om een afspraak te maken voor het inmeten.</li>
        <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-pill bg-wit/15 font-display text-sm font-bold">3</span>Na het inmeten ontvangt u een definitieve offerte.</li>
      </ol>
      <p class="mt-10 text-wit/80">Liever direct iemand spreken?</p>
      <a href={site.telHref} class="mt-1 inline-block font-display text-2xl font-bold tabular-nums text-wit no-underline hover:underline">{site.tel}</a>
    </div>
    <form class="min-w-0 bg-wit p-6 text-ink md:p-10 lg:col-span-7 lg:p-14" novalidate data-offerte data-key={key} data-slugs={JSON.stringify(slugs)}>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="naam" class="text-sm font-medium">Naam <span class="text-fout" aria-hidden="true">*</span></label>
          <input id="naam" name="Naam" autocomplete="name" required maxlength="100" class="veld mt-1.5" aria-describedby="naam-fout" />
          <p id="naam-fout" class="mt-1 hidden text-sm text-fout" data-fout>Vul uw naam in.</p>
        </div>
        <div class="sm:col-span-2">
          <label for="straat" class="text-sm font-medium">Straat en huisnummer <span class="text-fout" aria-hidden="true">*</span></label>
          <input id="straat" name="Straat en huisnummer" autocomplete="street-address" required maxlength="120" class="veld mt-1.5" aria-describedby="straat-fout" />
          <p id="straat-fout" class="mt-1 hidden text-sm text-fout" data-fout>Vul uw straat en huisnummer in.</p>
        </div>
        <div>
          <label for="postcode" class="text-sm font-medium">Postcode</label>
          <input id="postcode" name="Postcode" autocomplete="postal-code" maxlength="10" class="veld mt-1.5" />
        </div>
        <div>
          <label for="plaats" class="text-sm font-medium">Plaats <span class="text-fout" aria-hidden="true">*</span></label>
          <input id="plaats" name="Plaats" autocomplete="address-level2" required maxlength="60" class="veld mt-1.5" aria-describedby="plaats-fout" />
          <p id="plaats-fout" class="mt-1 hidden text-sm text-fout" data-fout>Vul uw plaats in.</p>
        </div>
        <div>
          <label for="tel" class="text-sm font-medium">Telefoon <span class="text-fout" aria-hidden="true">*</span></label>
          <input id="tel" name="Telefoon" type="tel" autocomplete="tel" required maxlength="20" class="veld mt-1.5" aria-describedby="tel-fout" />
          <p id="tel-fout" class="mt-1 hidden text-sm text-fout" data-fout>Vul een telefoonnummer in.</p>
        </div>
        <div>
          <label for="mail" class="text-sm font-medium">E-mail</label>
          <input id="mail" name="email" type="email" autocomplete="email" maxlength="120" class="veld mt-1.5" aria-describedby="mail-fout" />
          <p id="mail-fout" class="mt-1 hidden text-sm text-fout" data-fout>Vul een geldig e-mailadres in.</p>
        </div>
        <div class="sm:col-span-2">
          <!-- Meerdere producten tegelijk: aanvinken in een uitklaplijst, de keuze staat in de samenvatting. -->
          <p id="product-kop" class="text-sm font-medium">Product(en)</p>
          <details class="mt-1.5 min-w-0" data-producten>
            <summary class="veld flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden" aria-describedby="product-kop">
              <span class="min-w-0 truncate" data-keuze-tekst>Kies een of meer producten</span>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform [details[open]_&]:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="mt-2 grid gap-5 rounded-md bg-ijs p-4 sm:grid-cols-2">
              {offerteOpties.map((g) => (
                <fieldset class={g.groep === 'Anders' ? 'sm:col-span-2' : ''}>
                  <legend class="kicker text-ink-zacht">{g.groep}</legend>
                  <div class="mt-2 grid gap-0.5">
                    {g.opties.map((o) => <label class="flex cursor-pointer items-center gap-2.5 py-1.5 text-sm"><input type="checkbox" name="product-keuze" value={o} class="h-4 w-4 shrink-0 accent-groen" />{o}</label>)}
                  </div>
                </fieldset>
              ))}
            </div>
          </details>
        </div>
        <div class="flex gap-3 rounded-md bg-ijs p-4 text-sm sm:col-span-2">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-groen"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
          <p><span class="font-semibold">Foto's meesturen?</span> Mail ze na uw aanvraag naar <a href={`mailto:${site.mail}?subject=${encodeURIComponent("Foto's bij mijn offerteaanvraag")}`} class="font-semibold text-groen underline">{site.mail}</a>, met uw naam erbij.</p>
        </div>
        <div class="sm:col-span-2">
          <label for="bericht" class="text-sm font-medium">Opmerkingen</label>
          <textarea id="bericht" name="Opmerkingen" rows="4" maxlength="2000" placeholder="Bijvoorbeeld de maten, de gewenste kleur of wanneer u het liefst gebeld wordt." class="veld mt-1.5"></textarea>
        </div>
      </div>
      <!-- Honeypot van Web3Forms: onzichtbaar voor mensen, bots vullen het in. -->
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <button type="submit" class="btn btn-groen" data-verstuur>Verstuur aanvraag</button>
        <p class="text-sm text-ink-zacht">We gebruiken uw gegevens alleen voor deze aanvraag. Zie de <a href={url('privacy/')} class="underline">privacyverklaring</a>.</p>
      </div>
      <p class="mt-4 hidden rounded-sm bg-ijs px-4 py-3 text-sm" role="status" aria-live="polite" data-status></p>
      <!-- Bevestiging na versturen: vervangt het formulier, zodat niemand twijfelt of het gelukt is. -->
      <div class="hidden" role="status" aria-live="assertive" tabindex="-1" data-klaar>
        <div class="flex h-16 w-16 items-center justify-center rounded-pill bg-groen text-wit"><svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg></div>
        <h3 class="mt-6 text-2xl">Bedankt, uw aanvraag is verstuurd.</h3>
        <p class="mt-3 text-lg text-ink-zacht">We hebben uw gegevens ontvangen en nemen contact met u op om een afspraak te maken voor het inmeten.</p>
        <p class="mt-3 text-ink-zacht">Wilt u foto's meesturen of iets wijzigen? Bel <a href={site.telHref} class="font-semibold tabular-nums text-ink underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold text-ink underline">{site.mail}</a>.</p>
        <button type="button" class="btn btn-wit mt-8" data-nog-een>Nog een aanvraag doen</button>
      </div>
    </form>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-offerte]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const klaar = form.querySelector<HTMLElement>('[data-klaar]')!;
    const velden_wrap = Array.from(form.children).filter((c) => c !== klaar) as HTMLElement[];
    const toonKlaar = (open: boolean) => {
      velden_wrap.forEach((c) => c.classList.toggle('hidden', open));
      klaar.classList.toggle('hidden', !open);
      if (open) { klaar.scrollIntoView({ behavior: 'smooth', block: 'center' }); klaar.focus({ preventScroll: true }); }
    };
    klaar.querySelector('[data-nog-een]')?.addEventListener('click', () => { toonKlaar(false); status.classList.add('hidden'); form.querySelector<HTMLInputElement>('#naam')?.focus(); });
    const knop = form.querySelector<HTMLButtonElement>('[data-verstuur]')!;
    const keuzes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="product-keuze"]'));
    const keuzeTekst = form.querySelector<HTMLElement>('[data-keuze-tekst]')!;
    const keuzeLijst = form.querySelector<HTMLDetailsElement>('[data-producten]')!;
    const werkKeuzeBij = () => {
      const lijst = keuzes.filter((k) => k.checked).map((k) => k.value);
      keuzeTekst.textContent = lijst.length ? lijst.join(', ') : 'Kies een of meer producten';
      return lijst;
    };
    keuzes.forEach((k) => k.addEventListener('change', werkKeuzeBij));
    // Klik buiten de lijst klapt hem dicht.
    document.addEventListener('click', (e) => { if (keuzeLijst.open && !keuzeLijst.contains(e.target as Node)) keuzeLijst.open = false; });

    // Product vooraf kiezen via ?product=slug (vanaf een productpagina).
    const slugs = JSON.parse(form.dataset.slugs ?? '{}') as Record<string, string>;
    const gekozen = slugs[new URLSearchParams(location.search).get('product') ?? ''];
    const vink = () => { const k = keuzes.find((x) => x.value === gekozen); if (k) k.checked = true; werkKeuzeBij(); };
    if (gekozen) vink();

    const toon = (el: HTMLElement, tekst: string, soort: 'fout' | 'ok' | 'bezig') => {
      el.textContent = tekst; el.classList.remove('hidden');
      el.classList.toggle('text-fout', soort === 'fout');
      el.classList.toggle('bg-groen', soort === 'ok'); el.classList.toggle('text-wit', soort === 'ok'); el.classList.toggle('bg-ijs', soort !== 'ok');
    };

    // Inline controle per veld: bij verlaten alleen als er iets is ingevuld (anders schuift de knop weg onder de muis),
    // lege verplichte velden pas bij versturen.
    const velden = Array.from(form.querySelectorAll<HTMLInputElement>('input[required], input[type="email"]'));
    const controleer = (v: HTMLInputElement) => {
      const ok = v.checkValidity();
      v.setAttribute('aria-invalid', String(!ok));
      v.parentElement?.querySelector('[data-fout]')?.classList.toggle('hidden', ok);
      return ok;
    };
    velden.forEach((v) => { v.addEventListener('blur', () => { if (v.value || v.getAttribute('aria-invalid') === 'true') controleer(v); }); v.addEventListener('input', () => { if (v.getAttribute('aria-invalid') === 'true') controleer(v); }); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const geldig = velden.map(controleer).every(Boolean);
      if (!geldig) { form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }
      const key = form.dataset.key;
      if (!key) { toon(status, 'Het formulier is nog niet gekoppeld. Bel ons of stuur een e-mail, dan helpen we u direct.', 'fout'); status.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      knop.disabled = true; toon(status, 'Bezig met versturen…', 'bezig');
      const data = new FormData(form);
      const lijst = werkKeuzeBij();
      data.delete('product-keuze');
      if (lijst.length) data.append('Product', lijst.join(', '));
      data.append('access_key', key);
      data.append('subject', `Offerteaanvraag via de website${lijst.length ? `: ${lijst.join(', ')}` : ''}`);
      data.append('from_name', 'Website ZBN');
      try {
        const r = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const j = await r.json();
        if (r.ok && j.success) {
          form.reset(); if (gekozen) vink(); else werkKeuzeBij();
          status.classList.add('hidden');
          toonKlaar(true);
        } else throw new Error(j.message || 'fout');
      } catch {
        toon(status, 'Versturen is niet gelukt. Probeer het opnieuw, of bel ons.', 'fout'); status.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } finally { knop.disabled = false; }
    });
  }
</script>
