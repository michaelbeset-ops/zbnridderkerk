---
// Vijf sterren in oker, voor de Google-score en de reviews.
interface Props { aantal?: number; class?: string }
const { aantal = 5, class: cls = '' } = Astro.props;
---
<span class={`inline-flex gap-0.5 text-ster ${cls}`} aria-hidden="true">
  {Array.from({ length: aantal }).map(() => <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>)}
</span>
