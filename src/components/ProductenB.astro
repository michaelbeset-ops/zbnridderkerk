---
// Optie B: twee rijen, Buiten en Binnen. Elke rij schuift van links naar rechts; de categorie staat links als kop.
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
const binnenSlugs = ['raamdecoratie', 'binnenzonwering'];
const rijen = [
  { kop: 'Buiten', tekst: 'Zonwering, rolluiken, overkappingen en garagedeuren voor de gevel en het terras.', items: producten.filter((p) => !binnenSlugs.includes(p.slug)) },
  { kop: 'Binnen', tekst: 'Raamdecoratie en binnenzonwering, op maat voor elk raam.', items: producten.filter((p) => binnenSlugs.includes(p.slug)) },
];
---
<section id="producten" class="scroll-mt-24 overflow-hidden py-16 lg:py-24">
  <div class="wrap">
    <p class="kicker text-ink-zacht">Wat doen wij</p>
    <h2 class="mt-3 max-w-3xl text-3xl">Alles voor buiten en binnen, op maat gemaakt.</h2>
  </div>
  {rijen.map((r) => (
    <div class="mt-14 first:mt-10">
      <div class="wrap flex items-end justify-between gap-6 border-t border-lijn pt-6">
        <div>
          <h3 class="text-2xl">{r.kop}</h3>
          <p class="mt-1 text-ink-zacht">{r.tekst}</p>
        </div>
        <p class="hidden shrink-0 text-sm text-ink-zacht sm:block">{r.items.length} producten</p>
      </div>
      <ul class="slider mt-6 [--inzet:max(1.25rem,calc((100vw-80rem)/2+2.5rem))] !px-[var(--inzet)] !scroll-pl-[var(--inzet)] lg:!gap-6">
        {r.items.map((p) => (
          <li class="group w-[16rem] sm:w-[19rem]">
            <a href={url(`producten/${p.slug}/`)} class="block no-underline">
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-ijs">
                {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="304px" class="transition-transform duration-500 group-hover:scale-[1.03]" /> : <Vlak wat={p.naam.toLowerCase()} />}
              </div>
              <h4 class="mt-4 flex items-center justify-between gap-3 text-lg"><span>{p.naam}</span><span aria-hidden="true" class="text-ink-zacht transition-transform group-hover:translate-x-1">&rarr;</span></h4>
              <p class="mt-1 text-sm text-ink-zacht">{p.kort}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
