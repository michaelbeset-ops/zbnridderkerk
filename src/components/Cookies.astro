---
// Cookiemelding: de site zet zelf geen cookies. Alleen de Google Maps-kaart plaatst er (van Google), daarom
// laadt die pas na akkoord. De keuze staat in localStorage, dat is geen cookie en niet herleidbaar.
import { url } from '../data/site';
---
<div id="cookies" class="fixed inset-x-0 bottom-0 z-50 hidden border-t-4 border-groen bg-wit p-5 md:inset-x-auto md:bottom-6 md:left-6 md:max-w-md md:border-4 md:rounded-md" role="region" aria-label="Cookiemelding" data-cookies>
  <p class="font-display text-lg font-semibold">Kaart van Google tonen?</p>
  <p class="mt-2 text-sm">Deze site zet zelf geen cookies. Alleen de routekaart van Google Maps plaatst cookies van Google. Zonder akkoord ziet u het adres en een knop om de route te plannen. Meer in de <a href={url('privacy/')} class="underline">privacyverklaring</a>.</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" class="btn btn-groen text-sm" data-cookies-ja>Kaart tonen</button>
    <button type="button" class="btn btn-lijn text-sm" data-cookies-nee>Liever niet</button>
  </div>
</div>
<script>
  const SLEUTEL = 'zbn-kaart';
  const vak = document.querySelector<HTMLElement>('[data-cookies]');
  const lees = () => { try { return localStorage.getItem(SLEUTEL); } catch { return null; } };
  const bewaar = (v: string) => { try { localStorage.setItem(SLEUTEL, v); } catch { /* privémodus: dan vragen we volgende keer opnieuw */ } };
  // Kaarten laden alleen na akkoord; het adres en de routeknop staan er altijd.
  const laadKaarten = () => document.querySelectorAll<HTMLElement>('[data-kaart]').forEach((el) => {
    if (el.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = el.dataset.kaart ?? ''; f.title = 'Kaart met de locatie van de showroom'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
    f.className = 'absolute inset-0 h-full w-full border-0';
    el.replaceChildren(f);
  });
  const toon = (open: boolean) => vak?.classList.toggle('hidden', !open);
  const keuze = lees();
  if (keuze === 'ja') laadKaarten();
  else if (keuze !== 'nee') toon(true);
  vak?.querySelector('[data-cookies-ja]')?.addEventListener('click', () => { bewaar('ja'); laadKaarten(); toon(false); });
  vak?.querySelector('[data-cookies-nee]')?.addEventListener('click', () => { bewaar('nee'); toon(false); });
  document.querySelectorAll('[data-cookies-opnieuw]').forEach((b) => b.addEventListener('click', () => toon(true)));
</script>
