---
import { Image } from 'astro:assets';
import { site, url, producten, usps, tijden } from '../data/site';
import logo from '../assets/logo.png';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const menu = [
  ['Producten', '#producten'], ['Werkwijze', '#werkwijze'], ['Showroom', '#showroom'], ['Reviews', '#reviews'],
];
---
{deel === 'kop' ? (
  <>
    <!-- Dunne USP-balk: alleen punten die op hun eigen site staan. -->
    <div class="bg-groen text-wit">
      <ul class="mx-auto flex h-9 max-w-[76rem] items-center gap-6 overflow-hidden px-6 text-xs font-medium leading-none sm:text-sm md:px-9">
        {usps.map((u, i) => <li class={`flex items-center gap-2 whitespace-nowrap ${i > 1 ? 'hidden sm:flex' : ''} ${i > 2 ? 'sm:hidden lg:flex' : ''}`}><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>{u}</li>)}
        <li class="ml-auto hidden md:block"><a href={site.telHref} class="whitespace-nowrap tabular-nums no-underline hover:underline">{site.tel}</a></li>
      </ul>
    </div>
    <!-- Sticky navigatie als afgeronde witte kaart met schaduw. -->
    <header class="sticky top-0 z-40 px-3 pt-3 md:px-6">
      <div class="mx-auto flex h-16 max-w-[76rem] items-center justify-between gap-3 rounded-pill bg-wit/95 pl-2 pr-2 shadow-zacht ring-1 ring-lijn backdrop-blur-sm lg:h-[4.5rem] lg:pl-3">
        <a href={url('')} class="flex items-center gap-3 no-underline" aria-label="ZBN Zonwering, naar de homepage">
          <Image src={logo} alt="" width={176} height={120} loading="eager" class="h-12 w-auto lg:h-14" />
          <span class="hidden font-display text-[0.95rem] font-semibold leading-tight tracking-[-0.01em] text-ink md:block"><span class="block">Zonweringsbedrijf</span><span class="block">Noordenweg</span></span>
        </a>
        <nav aria-label="Hoofdmenu" class="hidden lg:block">
          <ul class="flex gap-1 font-display text-[0.95rem] font-semibold">
            {menu.map(([n, h]) => (
              <li class={n === 'Producten' ? 'group relative' : ''}>
                <a href={url(h)} class="block rounded-pill px-4 py-2 no-underline transition-colors hover:bg-ijs">{n}</a>
                {n === 'Producten' && (
                  <ul class="invisible absolute left-1/2 top-full z-50 mt-2 grid w-[30rem] -translate-x-1/2 grid-cols-2 gap-x-4 rounded-xl bg-wit p-3 opacity-0 shadow-kaart ring-1 ring-lijn transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 before:absolute before:-top-3 before:left-0 before:h-3 before:w-full">
                    {producten.map((p) => <li><a href={url(`producten/${p.slug}/`)} class="flex items-center justify-between rounded-sm px-3 py-2 text-sm font-medium no-underline hover:bg-ijs">{p.naam}<span aria-hidden="true" class="text-ink-zacht">&rarr;</span></a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-2">
          <a href={site.telHref} class="btn btn-wit hidden !px-4 !py-2.5 text-sm xl:inline-flex"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          <a href={url('#offerte')} class="btn btn-groen hidden !px-4 !py-2.5 text-sm md:inline-flex">Offerte aanvragen</a>
          <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill ring-1 ring-lijn lg:hidden" aria-expanded="false" aria-controls="menu-mobiel" aria-label="Menu" data-menu-knop>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" data-open-icoon /><path d="M6 6l12 12M18 6L6 18" class="hidden" data-dicht-icoon /></svg>
          </button>
        </div>
      </div>
      <div class="fixed inset-0 z-[-1] hidden bg-ink/40 lg:!hidden" data-menu-sluier aria-hidden="true"></div>
      <nav id="menu-mobiel" aria-label="Menu" class="mx-auto mt-2 hidden max-h-[calc(100dvh-6rem)] max-w-[76rem] overflow-y-auto rounded-xl bg-wit p-4 shadow-kaart ring-1 ring-lijn lg:!hidden" data-menu>
        <ul class="grid font-display text-lg font-semibold">
          {menu.map(([n, h]) => (
            <li class="border-b border-lijn last:border-0">
              <a href={url(h)} class="block py-3 no-underline">{n}</a>
              {n === 'Producten' && <ul class="mb-3 grid grid-cols-2 gap-x-4 font-body text-base font-normal">{producten.map((p) => <li><a href={url(`producten/${p.slug}/`)} class="block py-1.5 no-underline">{p.naam}</a></li>)}</ul>}
            </li>
          ))}
        </ul>
        <a href={site.telHref} class="btn btn-wit mt-4 w-full">Bel <span class="tabular-nums">{site.tel}</span></a>
      </nav>
    </header>
  </>
) : (
  <>
    <footer class="border-t border-lijn bg-ijs">
      <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:gap-6">
        <div class="md:col-span-4">
          <Image src={logo} alt="" width={176} height={120} class="h-16 w-auto" />
          <p class="mt-4 text-sm"><strong class="font-display text-base font-semibold">{site.naam} {site.rechtsvorm}</strong><br />{site.straat}<br />{site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
        </div>
        <div class="text-sm md:col-span-3">
          <p class="kicker text-ink-zacht">Contact</p>
          <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline">{site.mail}</a></p>
          <p class="mt-3"><a href={site.maps} target="_blank" rel="noopener" class="inline-block py-1 underline">Plan route</a></p>
        </div>
        <div class="text-sm md:col-span-3">
          <p class="kicker text-ink-zacht">Showroom</p>
          <ul class="mt-3">{tijden.map((t) => <li class="flex justify-between gap-4"><span>{t.naam.slice(0, 2)}</span><span class="tabular-nums">{t.open || 'Gesloten'}</span></li>)}</ul>
        </div>
        <div class="text-sm md:col-span-2">
          <p class="kicker text-ink-zacht">Over deze site</p>
          <ul class="mt-3 grid gap-1.5">
            <li><a href={url('privacy/')} class="inline-block py-1 underline">Privacyverklaring</a></li>
            <li><a href={url('algemene-voorwaarden/')} class="inline-block py-1 underline">Algemene voorwaarden</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap border-t border-lijn py-5 text-xs text-ink-zacht">
        <p>Website door <a href="https://www.sitefront.nl" rel="noopener" target="_blank" class="underline">Sitefront</a></p>
      </div>
    </footer>
    <!-- Vaste balk onderaan op mobiel: bellen en offerte altijd binnen handbereik. De body krijgt onderaan ruimte, zodat de footer niet afgedekt wordt. -->
    <div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-lijn bg-wit/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
      <a href={site.telHref} class="btn btn-wit !py-3 text-sm">Bellen</a>
      <a href={url('#offerte')} class="btn btn-groen !py-3 text-sm" data-balk-offerte>Offerte aanvragen</a>
    </div>
  </>
)}
<script>
  // Mobiel menu: open en dicht, en dicht na een klik op een link.
  const knop = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const sluier = document.querySelector<HTMLElement>('[data-menu-sluier]');
  if (knop && menu) {
    const zet = (open: boolean) => {
      menu.classList.toggle('hidden', !open); knop.setAttribute('aria-expanded', String(open));
      sluier?.classList.toggle('hidden', !open);
      knop.querySelector('[data-open-icoon]')?.classList.toggle('hidden', open);
      knop.querySelector('[data-dicht-icoon]')?.classList.toggle('hidden', !open);
      // Pagina niet laten scrollen achter het open menu.
      document.body.style.overflow = open ? 'hidden' : '';
    };
    knop.addEventListener('click', () => zet(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
    sluier?.addEventListener('click', () => zet(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) { zet(false); knop.focus(); } });
  }
  // Vaste balk op een productpagina: het product meegeven aan het formulier.
  const balk = document.querySelector<HTMLAnchorElement>('[data-balk-offerte]');
  const slug = location.pathname.match(/\/producten\/([^/]+)\/?$/)?.[1];
  if (balk && slug) balk.href = balk.href.replace('#offerte', `?product=${slug}#offerte`);
</script>
