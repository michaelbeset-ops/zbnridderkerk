---
import { Image } from 'astro:assets';
import { site, url } from '../data/site';
import logo from '../assets/logo.png';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const menu = [
  ['Producten', '#producten'], ['Werkwijze', '#werkwijze'], ['Showroom', '#showroom'], ['Reviews', '#reviews'], ['Offerte', '#offerte'],
];
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn bg-linnen/95 backdrop-blur-sm">
    <div class="wrap flex h-[4.25rem] items-center justify-between gap-3 lg:h-20">
      <a href={url('')} class="flex items-center gap-3 no-underline">
        <Image src={logo} alt="" width={176} height={120} loading="eager" class="h-11 w-auto lg:h-14" />
        <span class="hidden font-display text-lg font-semibold leading-tight tracking-[-0.01em] text-groen md:block"><span class="block">Zonweringsbedrijf</span><span class="block">Noordenweg</span></span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-[1rem] font-semibold">
          {menu.map(([n, h]) => <li><a href={url(h)} class="no-underline hover:underline">{n}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="btn btn-groen !px-3.5 !py-2 text-sm"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg><span class="whitespace-nowrap tabular-nums"><span class="sr-only">Bel </span>{site.tel}</span></a>
        <button type="button" class="btn btn-lijn !px-3 !py-2 text-sm lg:hidden" aria-expanded="false" aria-controls="menu-mobiel" data-menu-knop>Menu</button>
      </div>
    </div>
    <nav id="menu-mobiel" aria-label="Menu" class="hidden border-t border-lijn bg-linnen lg:!hidden" data-menu>
      <ul class="wrap grid py-2 text-lg font-semibold">
        {menu.map(([n, h]) => <li><a href={url(h)} class="block border-b border-lijn py-3 no-underline last:border-0">{n}</a></li>)}
      </ul>
    </nav>
  </header>
) : (
  <footer class="border-t border-lijn bg-zand">
    <div class="wrap grid gap-10 py-12 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-5">
        <Image src={logo} alt="" width={176} height={120} class="h-16 w-auto" />
        <p class="mt-4 text-sm"><strong>{site.naam} {site.rechtsvorm}</strong><br />{site.straat}<br />{site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
      </div>
      <div class="text-sm md:col-span-3">
        <p class="kicker text-ink-zacht">Contact</p>
        <p class="mt-2"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline">{site.mail}</a></p>
      </div>
      <div class="text-sm md:col-span-4">
        <p class="kicker text-ink-zacht">Over deze site</p>
        <ul class="mt-2 grid gap-1.5">
          <li><a href={url('privacy/')} class="underline">Privacyverklaring</a></li>
          <li><a href={url('algemene-voorwaarden/')} class="underline">Algemene voorwaarden</a></li>
          <li><button type="button" class="underline" data-cookies-opnieuw>Cookie-instellingen</button></li>
        </ul>
      </div>
    </div>
  </footer>
)}
<script>
  // Mobiel menu: open en dicht, en dicht na een klik op een link.
  const knop = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (knop && menu) {
    const zet = (open: boolean) => { menu.classList.toggle('hidden', !open); knop.setAttribute('aria-expanded', String(open)); knop.textContent = open ? 'Sluit' : 'Menu'; };
    knop.addEventListener('click', () => zet(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
  }
</script>
