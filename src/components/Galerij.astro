---
// Fotogalerij: grid op desktop, swipebaar op mobiel, klik opent een lightbox met toetsenbord en swipe.
// Vlakken met een markering zijn niet klikbaar: er is nog geen foto.
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { fotos } from './Fotos';
import type { Product } from '../data/site';
import { inZin } from '../data/site';
interface Props { naam: string; foto?: Product['foto']; fotoAlt?: string }
const { naam, foto, fotoAlt = '' } = Astro.props;
const groot = foto ? await getImage({ src: fotos[foto], width: 1800, format: 'webp', quality: 78 }) : null;
const plekken = 4;
---
<section class="wrap py-6 lg:py-10" aria-labelledby="galerij-kop">
  <h2 id="galerij-kop" class="text-2xl">Foto's van {inZin(naam)}</h2>
  <ul class="slider -mx-5 mt-6 md:mx-0 md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:px-0 lg:grid-cols-4" data-galerij>
    {groot && (
      <li class="w-[80vw] md:w-auto md:col-span-2 md:row-span-2">
        <button type="button" class="block aspect-[4/3] w-full overflow-hidden rounded-xl md:h-full" data-foto={groot.src} data-alt={fotoAlt} aria-label={`Vergroot: ${fotoAlt}`}>
          <Foto src={fotos[foto!]} alt={fotoAlt} sizes="(min-width: 1024px) 640px, (min-width: 768px) 50vw, 80vw" class="transition-transform duration-500 hover:scale-[1.03]" />
        </button>
      </li>
    )}
    {Array.from({ length: plekken }).map((_, i) => (
      <li class="w-[80vw] md:w-auto"><div class="aspect-[4/3] overflow-hidden rounded-xl md:h-full"><Vlak wat={`${inZin(naam)} ${i + (groot ? 2 : 1)}`} /></div></li>
    ))}
  </ul>
</section>
<!-- Lightbox: een dialog met de grote foto, vorige/volgende en sluiten. -->
<dialog class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-wit backdrop:bg-ink/80" data-lightbox aria-label="Foto vergroot">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between p-4">
      <p class="text-sm text-wit/80" data-lightbox-teller></p>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill ring-1 ring-wit/40 hover:bg-wit/10" aria-label="Sluiten" data-lightbox-dicht><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="relative flex flex-1 items-center justify-center overflow-hidden px-4 pb-4" data-lightbox-vlak>
      <img alt="" class="max-h-full max-w-full rounded-md object-contain" data-lightbox-img />
      <button type="button" class="absolute left-4 top-1/2 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-pill bg-wit/10 ring-1 ring-wit/40 hover:bg-wit/20 md:flex" aria-label="Vorige foto" data-lightbox-vorige><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <button type="button" class="absolute right-4 top-1/2 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-pill bg-wit/10 ring-1 ring-wit/40 hover:bg-wit/20 md:flex" aria-label="Volgende foto" data-lightbox-volgende><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
  </div>
</dialog>
<script>
  const knoppen = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-galerij] [data-foto]'));
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (box && knoppen.length) {
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const teller = box.querySelector<HTMLElement>('[data-lightbox-teller]')!;
    let i = 0;
    const toon = (n: number) => {
      i = (n + knoppen.length) % knoppen.length;
      img.src = knoppen[i].dataset.foto ?? ''; img.alt = knoppen[i].dataset.alt ?? '';
      teller.textContent = knoppen.length > 1 ? `${i + 1} van ${knoppen.length}` : '';
      // Pijlen alleen tonen als er iets te bladeren valt.
      box.querySelectorAll('[data-lightbox-vorige],[data-lightbox-volgende]').forEach((b) => b.classList.toggle('md:flex', knoppen.length > 1));
    };
    knoppen.forEach((k, n) => k.addEventListener('click', () => { toon(n); box.showModal(); }));
    box.querySelector('[data-lightbox-dicht]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-lightbox-vorige]')?.addEventListener('click', () => toon(i - 1));
    box.querySelector('[data-lightbox-volgende]')?.addEventListener('click', () => toon(i + 1));
    box.addEventListener('click', (e) => { if (e.target === box || e.target === box.querySelector('[data-lightbox-vlak]')) box.close(); });
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') toon(i - 1); if (e.key === 'ArrowRight') toon(i + 1); });
    // Swipe: horizontale beweging van meer dan 40 px bladert.
    let startX = 0;
    box.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    box.addEventListener('pointerup', (e) => { const d = e.clientX - startX; if (Math.abs(d) > 40) toon(d < 0 ? i + 1 : i - 1); });
  }
</script>
