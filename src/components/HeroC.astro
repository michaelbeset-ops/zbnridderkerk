---
// Optie C: foto over de volle breedte, de tekst in een wit paneel linksonder zodat de foto schoon blijft.
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url, producten } from '../data/site';
import hero from '../assets/hero.jpg';
---
<section class="relative -mt-[5.5rem] flex min-h-[min(48rem,94svh)] flex-col justify-end bg-groen pt-[5.5rem] lg:-mt-[6rem] lg:pt-[6rem]">
  <div class="absolute inset-0"><Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras" hero sizes="100vw" class="object-[50%_30%]" /></div>
  <div class="wrap relative pb-6 pt-24 lg:pb-10">
    <div class="max-w-3xl rounded-xl bg-wit p-6 shadow-kaart md:p-10">
      <p class="kicker text-ink-zacht">Zonweringsbedrijf Noordenweg, Ridderkerk</p>
      <h1 class="mt-4 text-4xl">Zonwering en rolluiken op maat.</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-zacht">Buiten- en binnenzonwering, rolluiken, garagedeuren en terrasoverkappingen. Bijna alles assembleren we zelf, en onze eigen monteurs plaatsen het.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
        <a href={url('#producten')} class="btn btn-wit">Bekijk producten</a>
      </div>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-lijn pt-5 text-sm">
        <div class="flex items-baseline gap-2"><dt class="text-ink-zacht">Showroom</dt><dd class="font-display font-semibold" data-vandaag>di t/m vr 8.30 tot 16.30</dd></div>
        <div class="flex items-center gap-2"><dt class="sr-only">Google</dt><dd><a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-display font-semibold no-underline hover:underline"><Sterren /> <span class="tabular-nums">{site.google.score}</span> op Google</a></dd></div>
        <div class="flex items-baseline gap-2"><dt class="text-ink-zacht">Bel</dt><dd><a href={site.telHref} class="font-display font-semibold tabular-nums no-underline hover:underline">{site.tel}</a></dd></div>
      </dl>
    </div>
  </div>
</section>
<nav aria-label="Snel naar een product" class="border-b border-lijn bg-wit">
  <ul class="slider wrap py-4 md:flex-wrap md:gap-2 md:overflow-visible">
    {producten.map((p) => <li><a href={url(`producten/${p.slug}/`)} class="btn btn-wit !px-4 !py-2 text-sm !shadow-none ring-1 ring-lijn hover:ring-groen">{p.naam}</a></li>)}
  </ul>
</nav>
