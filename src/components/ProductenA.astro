---
// Optie A: een horizontale kaartenslider met snap-scroll (zoals de projectensectie van bluey.dev).
// Drie kaarten in beeld op desktop, pijltjes rechtsboven, de rij loopt tot de rand van het scherm.
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
---
<section id="producten" class="scroll-mt-24 overflow-hidden py-16 lg:py-24">
  <div class="wrap grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="kicker text-ink-zacht">Wat doen wij</p>
      <h2 class="mt-3 text-3xl">Alles voor buiten en binnen, op maat gemaakt.</h2>
    </div>
    <div class="flex items-end justify-between gap-4 lg:col-span-5 lg:pb-1">
      <p class="text-lg text-ink-zacht">Negen producten, allemaal op maat en door ons gemonteerd. Schuif door de rij of kies direct.</p>
      <div class="hidden shrink-0 gap-2 md:flex">
        <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill bg-wit shadow-zacht ring-1 ring-lijn hover:bg-groen hover:text-wit" aria-label="Vorige producten" data-prod-vorige><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill bg-wit shadow-zacht ring-1 ring-lijn hover:bg-groen hover:text-wit" aria-label="Volgende producten" data-prod-volgende><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </div>
  </div>
  <ul class="slider mt-10 [--inzet:max(1.25rem,calc((100vw-80rem)/2+2.5rem))] !px-[var(--inzet)] !scroll-pl-[var(--inzet)] lg:!gap-6" data-prod-slider>
    {producten.map((p, i) => (
      <li class="group w-[18rem] sm:w-[22rem] lg:w-[24rem]">
        <a href={url(`producten/${p.slug}/`)} class="block no-underline">
          <div class="vervaag aspect-[4/5] overflow-hidden rounded-xl bg-ijs">
            {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="384px" class="transition-transform duration-500 group-hover:scale-[1.03]" /> : <Vlak wat={p.naam.toLowerCase()} />}
          </div>
          <div class="relative -mt-14 px-1">
            <p class="kicker text-ink-zacht">{String(i + 1).padStart(2, '0')} / {String(producten.length).padStart(2, '0')}</p>
            <h3 class="mt-2 flex items-center justify-between gap-3 text-xl"><span>{p.naam}</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-colors group-hover:bg-groen group-hover:text-wit group-hover:ring-groen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></h3>
            <p class="mt-2 text-ink-zacht">{p.kort}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
<script>
  const s = document.querySelector<HTMLElement>('[data-prod-slider]');
  const stap = () => ((s?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 320) + 24;
  document.querySelector('[data-prod-vorige]')?.addEventListener('click', () => s?.scrollBy({ left: -stap(), behavior: 'smooth' }));
  document.querySelector('[data-prod-volgende]')?.addEventListener('click', () => s?.scrollBy({ left: stap(), behavior: 'smooth' }));
</script>
