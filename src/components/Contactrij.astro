---
// Drie manieren om contact op te nemen, vlak boven de footer.
import { site } from '../data/site';
const items = [
  { href: site.telHref, kop: `Bel ${site.tel}`, sub: 'Tijdens de openingstijden van de showroom', icoon: 'M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z' },
  { href: `mailto:${site.mail}`, kop: `Mail ${site.mail}`, sub: 'We reageren zo snel mogelijk', icoon: 'M3 6h18v12H3zM3 7l9 6 9-6' },
  { href: site.maps, kop: 'Bezoek de showroom', sub: `${site.straat}, ${site.plaats}`, icoon: 'M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', extern: true },
];
---
<section aria-label="Contact" class="wrap py-12 lg:py-16">
  <ul class="grid divide-y divide-lijn rounded-xl bg-wit ring-1 ring-lijn md:grid-cols-3 md:divide-x md:divide-y-0">
    {items.map((i) => (
      <li>
        <a href={i.href} target={i.extern ? '_blank' : undefined} rel={i.extern ? 'noopener' : undefined} class="flex items-center gap-4 p-5 no-underline hover:bg-ecru md:p-6">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-groen text-wit"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={i.icoon}/></svg></span>
          <span><strong class="block font-display font-semibold">{i.kop}</strong><span class="text-sm text-ink-zacht">{i.sub}</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>
