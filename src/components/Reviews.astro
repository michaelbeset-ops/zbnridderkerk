---
// Reviews als horizontale slider met snap-scroll. Teksten letterlijk van het Google-profiel (aangeleverd door Michael).
import Sterren from './Sterren.astro';
import { site, reviews } from '../data/site';
---
<section id="reviews" class="scroll-mt-24 overflow-hidden bg-ijs py-16 lg:py-24">
  <div class="wrap grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="kicker text-ink-zacht">Reviews</p>
      <h2 class="mt-3 text-3xl">Wat klanten zeggen.</h2>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 lg:col-span-5 lg:pb-1">
      <a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold no-underline hover:underline"><Sterren /> <span class="tabular-nums">{site.google.score}</span> uit 5 op Google, {site.google.aantal} reviews<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
      <div class="hidden gap-2 md:flex">
        <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill bg-wit shadow-zacht ring-1 ring-lijn hover:bg-groen hover:text-wit" aria-label="Vorige reviews" data-slider-vorige><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button type="button" class="flex h-11 w-11 items-center justify-center rounded-pill bg-wit shadow-zacht ring-1 ring-lijn hover:bg-groen hover:text-wit" aria-label="Volgende reviews" data-slider-volgende><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </div>
  </div>
  <!-- De slider loopt tot de rand van het scherm; de eerste kaart lijnt uit met de inhoud. -->
  <ul class="slider mt-10 [--inzet:max(1.25rem,calc((100vw-80rem)/2+2.5rem))] !px-[var(--inzet)] !scroll-pl-[var(--inzet)]" data-slider>
    {reviews.map((r) => (
      <li class="flex w-[20rem] flex-col rounded-xl bg-wit p-6 shadow-zacht ring-1 ring-lijn sm:w-[24rem] md:p-7">
        <Sterren />
        <blockquote class="mt-4 flex-1"><p>{r.tekst}</p></blockquote>
        <p class="mt-5 text-sm text-ink-zacht"><strong class="font-display font-semibold text-ink">{r.naam}</strong><br />Google, {r.wanneer}</p>
      </li>
    ))}
  </ul>
</section>
<script>
  // Pijltjes schuiven een kaart verder; op touch werkt de snap-scroll zelf.
  const s = document.querySelector<HTMLElement>('[data-slider]');
  const stap = () => (s?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 320;
  document.querySelector('[data-slider-vorige]')?.addEventListener('click', () => s?.scrollBy({ left: -stap() - 16, behavior: 'smooth' }));
  document.querySelector('[data-slider-volgende]')?.addEventListener('click', () => s?.scrollBy({ left: stap() + 16, behavior: 'smooth' }));
</script>
