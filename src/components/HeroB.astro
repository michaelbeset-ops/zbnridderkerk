---
// Optie B: de foto als grote afgeronde kaart binnen de witte pagina, met de tekst erop. Kruisjes op de hoeken.
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url, producten } from '../data/site';
import hero from '../assets/hero.jpg';
---
<section class="wrap pt-4 lg:pt-6">
  <div class="kruis kruis-onder relative flex min-h-[min(44rem,86svh)] flex-col justify-end overflow-hidden rounded-xl bg-groen text-wit shadow-kaart">
    <div class="absolute inset-0"><Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras" hero sizes="100vw" class="object-[50%_35%]" /></div>
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"></div>
    <div class="relative grid gap-8 p-6 pt-28 md:p-10 lg:grid-cols-12 lg:items-end lg:p-14">
      <div class="lg:col-span-8">
        <p class="kicker text-wit/80">Zonweringsbedrijf Noordenweg, Ridderkerk</p>
        <h1 class="mt-5 max-w-[14ch] text-4xl text-wit">Zonwering en rolluiken op maat.</h1>
        <p class="mt-6 max-w-xl text-lg text-wit/90">Buiten- en binnenzonwering, rolluiken, garagedeuren en terrasoverkappingen. Bijna alles assembleren we zelf, en onze eigen monteurs plaatsen het.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={url('#offerte')} class="btn btn-wit">Offerte aanvragen</a>
          <a href={url('#producten')} class="btn btn-glas">Bekijk producten</a>
        </div>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-wit/90 lg:col-span-4 lg:flex-col lg:items-end lg:gap-y-2 lg:text-right">
        <li><span class="text-wit/70">Showroom</span> <strong class="font-display" data-vandaag>di t/m vr 8.30 tot 16.30</strong></li>
        <li><a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 no-underline hover:underline"><Sterren /> <strong class="font-display tabular-nums">{site.google.score}</strong> op Google</a></li>
        <li><a href={site.telHref} class="font-display text-xl font-bold tabular-nums no-underline hover:underline">{site.tel}</a></li>
      </ul>
    </div>
  </div>
  <ul class="slider -mx-5 mt-6 md:mx-0 md:flex-wrap md:gap-2 md:overflow-visible md:px-0">
    {producten.map((p) => <li><a href={url(`producten/${p.slug}/`)} class="btn btn-wit !px-4 !py-2 text-sm !shadow-none ring-1 ring-lijn hover:ring-groen">{p.naam}</a></li>)}
  </ul>
</section>
