---
// Productsectie: op desktop een grid van 3 x 3 met alle negen producten in beeld, op tablet 2 kolommen,
// op mobiel een swipe-rij met snap-scroll (kaart ongeveer 80 procent breed, zodat de volgende al zichtbaar is).
// Kaart: scherpe foto 4:3, label Buiten of Binnen, naam met pijl, een regel uitleg.
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
const binnenSlugs = ['raamdecoratie', 'binnenzonwering'];
const lijst = [...producten.filter((p) => !binnenSlugs.includes(p.slug)), ...producten.filter((p) => binnenSlugs.includes(p.slug))];
---
<section id="producten" class="scroll-mt-24 overflow-hidden py-16 lg:py-24">
  <div class="wrap grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="kicker text-ink-zacht">Wat doen wij</p>
      <h2 class="mt-3 text-[1.85rem] sm:text-3xl">Alles voor buiten<br />en binnen,<br />op maat gemaakt.</h2>
    </div>
    <p class="text-lg text-ink-zacht lg:col-span-5 lg:pb-1">Negen producten, allemaal op maat en door ons gemonteerd. Kies een product voor uitleg en foto's.</p>
  </div>
  <ul class="slider mt-10 [--inzet:max(1.25rem,calc((100vw-80rem)/2+2.5rem))] !px-[var(--inzet)] !scroll-pl-[var(--inzet)] sm:wrap sm:mt-12 sm:grid sm:grid-cols-2 sm:!gap-6 sm:!overflow-visible lg:grid-cols-3 lg:!gap-x-8 lg:!gap-y-12">
    {lijst.map((p) => (
      <li class="group w-[80vw] max-w-[22rem] sm:w-auto sm:max-w-none">
        <a href={url(`producten/${p.slug}/`)} class="block no-underline">
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-ijs">
            {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 80vw" class="transition-transform duration-500 group-hover:scale-[1.04]" /> : <Vlak wat={p.naam.toLowerCase()} />}
          </div>
          <div class="mt-4 px-1">
            <p class="kicker text-ink-zacht">{binnenSlugs.includes(p.slug) ? 'Binnen' : 'Buiten'}</p>
            <h3 class="mt-2 flex items-center justify-between gap-3 text-lg sm:text-xl"><span class="min-w-0 break-words">{p.naam}</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-colors group-hover:bg-groen group-hover:text-wit group-hover:ring-groen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></h3>
            <p class="mt-2 text-ink-zacht">{p.kort}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
