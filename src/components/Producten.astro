---
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import Vink from './Vink.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
---
<section id="producten" class="wrap scroll-mt-20 py-16 lg:py-24">
  <div class="grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-5"><p class="kicker text-oker-ink">Onze producten</p><h2 class="mt-2 text-3xl">Wat doen wij?</h2></div>
    <p class="text-lg text-ink-zacht lg:col-span-6 lg:col-start-7 lg:pt-2">Zonwering voor buiten en binnen, rolluiken, overkappingen, garagedeuren en horren. Alles op maat en door onszelf gemonteerd. Klik op een product voor meer informatie en foto's.</p>
  </div>
  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {producten.map((p, i) => (
      <li class={`group relative flex flex-col overflow-hidden rounded-xl bg-wit ring-1 ring-lijn ${i === producten.length - 1 ? 'lg:col-span-3 lg:flex-row' : ''}`}>
        <a href={url(`producten/${p.slug}/`)} class={`aspect-[3/2] overflow-hidden bg-zand ${i === producten.length - 1 ? 'lg:aspect-auto lg:w-1/2 lg:shrink-0' : ''}`} tabindex="-1" aria-hidden="true">
          {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="transition-transform duration-300 group-hover:scale-[1.03]" /> : <Vlak wat={p.naam.toLowerCase()} />}
        </a>
        <div class="flex flex-1 flex-col p-5 md:p-6">
          <h3 class="text-xl"><a href={url(`producten/${p.slug}/`)} class="no-underline after:absolute after:inset-0 group-hover:underline">{p.naam}</a></h3>
          <p class="mt-1 text-ink-zacht">{p.kort}</p>
          <ul class="mt-4 grid gap-1.5 text-sm">
            {p.punten.slice(0, 3).map((x) => <li class="flex gap-2"><Vink />{x}</li>)}
          </ul>
          <p class="mt-auto pt-5 font-display font-semibold text-groen">Bekijk {p.naam.toLowerCase()} <span aria-hidden="true">&rarr;</span></p>
        </div>
      </li>
    ))}
  </ul>
</section>
