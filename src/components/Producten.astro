---
// Productkaarten: foto die onderaan zacht in wit overloopt, klein label, sterke kop, een zin en een pijl.
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
---
<section id="producten" class="wrap scroll-mt-24 py-16 lg:py-24">
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="kicker text-ink-zacht">Wat doen wij</p>
      <h2 class="mt-3 text-3xl">Alles voor buiten en binnen, op maat gemaakt.</h2>
    </div>
    <p class="text-lg text-ink-zacht lg:col-span-5 lg:pb-1">Zonwering, rolluiken, garagedeuren en terrasoverkappingen. Kies een product voor meer uitleg en foto's, of vraag direct een offerte aan.</p>
  </div>
  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {producten.map((p, i) => (
      <li class="group relative">
        <a href={url(`producten/${p.slug}/`)} class="block no-underline">
          <div class="vervaag aspect-[4/3] overflow-hidden rounded-xl bg-ijs">
            {p.foto ? <Foto src={fotos[p.foto]} alt="" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" class="transition-transform duration-500 group-hover:scale-[1.03]" /> : <Vlak wat={p.naam.toLowerCase()} />}
          </div>
          <div class="relative -mt-10 px-1">
            <p class="kicker text-ink-zacht">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 flex items-center justify-between gap-3 text-xl"><span>{p.naam}</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-colors group-hover:bg-groen group-hover:text-wit group-hover:ring-groen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></h3>
            <p class="mt-2 text-ink-zacht">{p.kort}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
