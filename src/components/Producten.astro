---
import Foto from './Foto.astro';
import Vlak from './Vlak.astro';
import { producten, url } from '../data/site';
import { fotos } from './Fotos';
---
<section id="producten" class="wrap scroll-mt-20 py-16 lg:py-24">
  <div class="grid gap-6 lg:grid-cols-12">
    <h2 class="text-3xl lg:col-span-5">Wat doen wij?</h2>
    <p class="text-lg text-ink-zacht lg:col-span-6 lg:col-start-7 lg:pt-2">Zonwering voor buiten en binnen, rolluiken, overkappingen, garagedeuren en horren. Alles op maat en door onszelf gemonteerd. Klik op een product voor meer informatie en foto's.</p>
  </div>
  <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-5 lg:gap-x-6">
    {producten.map((p) => (
      <li>
        <a href={url(`producten/${p.slug}/`)} class="group block no-underline">
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-zand">
            {p.foto ? <Foto src={fotos[p.foto]} alt={p.fotoAlt ?? ''} sizes="(min-width: 1024px) 230px, (min-width: 768px) 33vw, 50vw" class="transition-transform duration-300 group-hover:scale-[1.03]" /> : <Vlak wat={p.naam.toLowerCase()} />}
          </div>
          <h3 class="mt-3 text-base hyphens-auto sm:text-lg underline decoration-transparent decoration-2 underline-offset-4 transition-colors group-hover:decoration-roest">{p.naam}</h3>
          <p class="mt-1 text-sm text-ink-zacht">{p.kort}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
