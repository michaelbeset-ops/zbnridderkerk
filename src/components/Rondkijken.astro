---
// Rondkijken in de showroom. Begint buiten bij de gevel; met "Kijk binnen" staat u midden in de showroom en kijkt u
// 360 graden rond: slepen, vegen, pijlknoppen of pijltoetsen. Het panorama is gemaakt van 12 foto's die ZBN vanaf één
// plek nam (bron/showroom-360). Het loopt eindeloos door: twee kopieën naast elkaar, verschoven met modulo de breedte.
// Het panorama laadt pas na de eerste aanraking of focus, zodat de pagina licht blijft.
import { Image, getImage } from 'astro:assets';
import gevel from '../assets/showroom/0-gevel.webp';
import panorama from '../assets/showroom/360.jpg';

const breedtes = [2600, 4400, panorama.width];
const varianten = await Promise.all(breedtes.map((w) => getImage({ src: panorama, width: w, format: 'webp', quality: 72 })));
const srcset = varianten.map((v, i) => `${v.src} ${breedtes[i]}w`).join(', ');
const pijl = (d: string) => `<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
const alt = 'Showroom van ZBN rondom: folderrek met doekstalen, de toonbank, de wand met rolluiken en screens, de groene wand met zonneschermen, de kast met binnenzonwering en de ingang met garagedeuren';
---
<div class="rondkijk relative h-full overflow-clip rounded-xl bg-ink" data-rondkijk tabindex="0" role="region"
  aria-roledescription="rondleiding" aria-label="Rondkijken in de showroom. Gebruik de pijltoetsen om te draaien.">

  <!-- Binnen: het 360-gradenpanorama, twee keer naast elkaar zodat het rond loopt. -->
  <div class="binnen absolute inset-0" data-binnen hidden>
    <div class="baan flex h-full w-max" data-baan>
      <img src={varianten[1].src} srcset={srcset} sizes="(min-width: 1024px) 4400px, 2600px" alt={alt} draggable="false" loading="lazy" decoding="async" class="h-full w-auto max-w-none" />
      <img src={varianten[1].src} srcset={srcset} sizes="(min-width: 1024px) 4400px, 2600px" alt="" aria-hidden="true" draggable="false" loading="lazy" decoding="async" class="h-full w-auto max-w-none" />
    </div>
  </div>

  <!-- Buiten: de gevel met de knop om naar binnen te gaan. -->
  <div class="buiten absolute inset-0" data-buiten>
    <Image src={gevel} alt="Gevel van ZBN zonwering aan de Noordenweg met rolluik, overkapping en het logo" widths={[640, 960, 1400]}
      sizes="(min-width: 1024px) 700px, 100vw" format="webp" quality={74} loading="lazy" class="block h-full w-full object-cover" />
  </div>

  <div class="absolute top-3 left-3 flex gap-2 md:top-4 md:left-4">
    <button type="button" class="pil" data-naar-buiten hidden><Fragment set:html={pijl('M15 5l-7 7 7 7')} />Buiten</button>
    <p class="pil pointer-events-none whitespace-nowrap max-[359px]:hidden" data-hint hidden>360°<span class="max-sm:hidden">, sleep om rond te kijken</span></p>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-linear-to-t from-ink/75 to-transparent p-3 pt-10 text-wit sm:p-4 sm:pt-16 md:p-5 md:pt-20">
    <p class="min-w-0 font-display text-base leading-tight font-bold sm:text-lg md:text-xl" aria-live="polite" data-titel>Buiten aan de Noordenweg</p>
    <button type="button" class="btn btn-wit pointer-events-auto shrink-0 max-sm:px-4 max-sm:py-2.5" data-kijk-binnen>Kijk binnen</button>
    <div class="pointer-events-auto flex shrink-0 gap-2" data-pijlen hidden>
      <button type="button" class="kant" data-draai="-1" aria-label="Draai naar links"><Fragment set:html={pijl('M15 5l-7 7 7 7')} /></button>
      <button type="button" class="kant" data-draai="1" aria-label="Draai naar rechts"><Fragment set:html={pijl('M9 5l7 7-7 7')} /></button>
    </div>
  </div>
</div>

<style>
  .rondkijk { user-select: none; -webkit-user-select: none; touch-action: pan-y; }
  .binnen { cursor: grab; }
  .rondkijk.sleept .binnen { cursor: grabbing; }
  .baan { will-change: transform; }
  .buiten { transition: opacity .6s ease, transform .9s cubic-bezier(.3,.6,.2,1); transform-origin: 60% 50%; }
  .rondkijk.is-binnen .buiten { opacity: 0; transform: scale(1.6); pointer-events: none; }
  .pil { display: inline-flex; align-items: center; gap: .25rem; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--color-ink);
    padding: .4rem .9rem .4rem .7rem; font-size: var(--text-sm); font-weight: 600; box-shadow: var(--shadow-zacht); }
  button.pil { cursor: pointer; }
  .pil:hover { background: var(--color-wit); }
  .kant { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: rgba(255,255,255,.92);
    color: var(--color-ink); box-shadow: var(--shadow-zacht); cursor: pointer; }
  .kant:hover { background: var(--color-wit); }
  @media (min-width: 640px) { .kant { width: 3rem; height: 3rem; } }
  [hidden] { display: none !important; }
</style>

<script>
  for (const kader of document.querySelectorAll<HTMLElement>('[data-rondkijk]')) {
    const $ = <T extends HTMLElement>(s: string) => kader.querySelector<T>(s)!;
    const binnen = $('[data-binnen]');
    const baan = $('[data-baan]');
    const beeld = baan.querySelector('img')!;
    const kijkBinnen = $('[data-kijk-binnen]');
    const naarBuiten = $('[data-naar-buiten]');
    const pijlen = $('[data-pijlen]');
    const hint = $('[data-hint]');
    const titel = $('[data-titel]');
    const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let offset = 0;
    let animatie = 0;
    let draaitVanzelf = false;

    // Het panorama pas ophalen bij de eerste aanraking, dan staat het klaar als iemand op Kijk binnen klikt.
    let geladen = false;
    const laad = () => { if (!geladen) { geladen = true; binnen.hidden = false; } };
    kader.addEventListener('pointerenter', laad, { once: true });
    kader.addEventListener('focusin', laad, { once: true });
    kader.addEventListener('touchstart', laad, { once: true, passive: true });

    const breedte = () => beeld.getBoundingClientRect().width || 1;
    const zet = () => {
      const w = breedte();
      offset = ((offset % w) + w) % w;
      baan.style.transform = `translateX(${-offset}px)`;
    };
    const binnenNu = () => kader.classList.contains('is-binnen');

    // Rustig vanzelf ronddraaien tot iemand zelf iets doet (niet bij voorkeur voor minder beweging).
    let vorige = 0;
    const tik = (t: number) => {
      if (!draaitVanzelf) return;
      if (vorige) { offset += (t - vorige) * 0.025; zet(); }
      vorige = t;
      animatie = requestAnimationFrame(tik);
    };
    const stopVanzelf = () => { draaitVanzelf = false; vorige = 0; cancelAnimationFrame(animatie); };

    const naarBinnen = () => {
      laad();
      kader.classList.add('is-binnen');
      kijkBinnen.hidden = true; pijlen.hidden = false; naarBuiten.hidden = false; hint.hidden = false;
      titel.textContent = 'In de showroom, 360°';
      offset = breedte() * 0.12; zet();
      kader.focus({ preventScroll: true });
      if (!rustig) { draaitVanzelf = true; animatie = requestAnimationFrame(tik); }
    };
    const terug = () => {
      stopVanzelf();
      kader.classList.remove('is-binnen');
      kijkBinnen.hidden = false; pijlen.hidden = true; naarBuiten.hidden = true; hint.hidden = true;
      titel.textContent = 'Buiten aan de Noordenweg';
      kijkBinnen.focus();
    };
    kijkBinnen.addEventListener('click', naarBinnen);
    naarBuiten.addEventListener('click', terug);

    // Draaien met een zachte beweging over een kwart van het kader.
    const draai = (richting: number) => {
      stopVanzelf();
      const van = offset, naar = offset + richting * kader.clientWidth * 0.35;
      if (rustig) { offset = naar; zet(); return; }
      const start = performance.now();
      const stap = (t: number) => {
        const p = Math.min(1, (t - start) / 450);
        offset = van + (naar - van) * (1 - Math.pow(1 - p, 3)); zet();
        if (p < 1) animatie = requestAnimationFrame(stap);
      };
      cancelAnimationFrame(animatie); animatie = requestAnimationFrame(stap);
    };
    for (const k of kader.querySelectorAll<HTMLElement>('[data-draai]')) k.addEventListener('click', () => draai(Number(k.dataset.draai)));
    kader.addEventListener('keydown', (e) => {
      if (!binnenNu()) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); draai(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); draai(1); }
    });

    // Slepen en vegen; verticaal blijft de pagina scrollen.
    let startX = 0, startOffset = 0, sleept = false;
    binnen.addEventListener('pointerdown', (e) => {
      if (!binnenNu()) return;
      stopVanzelf(); sleept = true; startX = e.clientX; startOffset = offset;
      binnen.setPointerCapture(e.pointerId); kader.classList.add('sleept');
    });
    binnen.addEventListener('pointermove', (e) => { if (sleept) { offset = startOffset - (e.clientX - startX); zet(); } });
    const los = () => { sleept = false; kader.classList.remove('sleept'); };
    binnen.addEventListener('pointerup', los);
    binnen.addEventListener('pointercancel', los);
    addEventListener('resize', () => { if (binnenNu()) zet(); });
  }
</script>
