---
// Rondlopen door de showroom met de eigen foto's. Begint buiten bij de gevel; klik op de deur en u zoomt naar binnen.
// Binnen staan klikbare punten in de foto (daarheen lopen) en pijlen links en rechts (draaien naar de wand ernaast).
// Geen echte 360 graden: de foto's zijn vanaf verschillende plekken genomen. De punten staan in procenten van de foto.
// Alleen de gevel laadt meteen; de rest pas als iemand de viewer aanraakt of focust.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gevel from '../assets/showroom/0-gevel.webp';
import overzicht from '../assets/showroom/1-overzicht.jpg';
import ingang from '../assets/showroom/1-ingang.jpg';
import rolluiken from '../assets/showroom/2-rolluiken.jpg';
import toonbank from '../assets/showroom/3-toonbank.jpg';
import zonneschermen from '../assets/showroom/4-zonneschermen.jpg';
import stalen from '../assets/showroom/5-stalen.jpg';

type Punt = { naar: string; x: number; y: number; label: string };
type Plek = { id: string; src: ImageMetadata; label: string; alt: string; punten: Punt[]; links?: string; rechts?: string };

const plekken: Plek[] = [
  { id: 'gevel', src: gevel, label: 'Buiten aan de Noordenweg', alt: 'Gevel van ZBN zonwering aan de Noordenweg met rolluik, overkapping en het logo',
    punten: [{ naar: 'overzicht', x: 60, y: 50, label: 'Naar binnen' }] },
  { id: 'overzicht', src: overzicht, label: 'Binnenzonwering', alt: 'Kast van steigerhout met jaloezieën, plissés en rolgordijnen, rechts een stalenrek bij de toonbank',
    punten: [{ naar: 'ingang', x: 80, y: 42, label: 'Folders en stalen' }], links: 'zonneschermen', rechts: 'rolluiken' },
  { id: 'ingang', src: ingang, label: 'Folders en doekstalen', alt: 'Wand met folders, kasten van zonneschermen en een rek met doekstalen',
    punten: [], links: 'overzicht', rechts: 'rolluiken' },
  { id: 'rolluiken', src: rolluiken, label: 'Rolluiken en screens', alt: 'Grijze wand met rolluiken en screens, de toonbank en de grote houten tafel',
    punten: [{ naar: 'toonbank', x: 30, y: 55, label: 'Toonbank' }], links: 'ingang', rechts: 'toonbank' },
  { id: 'toonbank', src: toonbank, label: 'Toonbank en tafel', alt: 'Toonbank van steigerhout voor de wand met rolluiken, rechts de tafel en de groene wand',
    punten: [{ naar: 'zonneschermen', x: 80, y: 36, label: 'Zonneschermen' }], links: 'rolluiken', rechts: 'zonneschermen' },
  { id: 'zonneschermen', src: zonneschermen, label: 'Zonneschermen aan de wand', alt: 'Groene wand met zonneschermen op consoles, daaronder een lange kast met stalen',
    punten: [{ naar: 'stalen', x: 58, y: 62, label: 'Stalenkast' }], links: 'toonbank', rechts: 'overzicht' },
  { id: 'stalen', src: stalen, label: 'De stalenkast', alt: 'Lange kast van steigerhout vol hangende doekstalen en stalenboeken',
    punten: [], links: 'zonneschermen', rechts: 'overzicht' },
];
const naam = Object.fromEntries(plekken.map((p) => [p.id, p.label]));
const pijl = (d: string) => `<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
---
<div class="rondloop relative h-full overflow-clip rounded-xl bg-ink" data-rondloop tabindex="0" role="region"
  aria-roledescription="rondleiding" aria-label="Rondlopen door de showroom. Klik op de punten om verder te lopen, pijltoetsen om te draaien.">
  {plekken.map((p, i) => (
    <div class="plek" data-plek={p.id} data-label={p.label} data-links={p.links} data-rechts={p.rechts}
      hidden={i > 0} data-actief={i === 0 ? '' : undefined} aria-hidden={i > 0 ? 'true' : undefined}>
      <div class="vlak">
        <Image src={p.src} alt={p.alt} widths={[640, 960, 1400, 2000]} sizes="(min-width: 1024px) 940px, 135vw"
          format="webp" quality={74} loading="lazy" draggable="false" class="block h-full w-full" />
        {p.punten.map((pt) => (
          <button type="button" class:list={['punt', { rechts: pt.x >= 65 }]} style={`left:${pt.x}%;top:${pt.y}%`} data-naar={pt.naar}>
            <span class="stip" aria-hidden="true"></span><span class="tekst">{pt.label}</span>
          </button>
        ))}
      </div>
    </div>
  ))}

  <div class="absolute top-3 left-3 flex gap-2 md:top-4 md:left-4">
    <button type="button" class="pil" data-terug hidden>
      <Fragment set:html={pijl('M15 5l-7 7 7 7')} />Terug
    </button>
    <button type="button" class="pil" data-buiten hidden>Buiten</button>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-linear-to-t from-ink/75 to-transparent p-3 pt-10 text-wit sm:p-4 sm:pt-16 md:p-5 md:pt-20">
    <p class="min-w-0" aria-live="polite">
      <span class="hidden text-sm opacity-85 sm:block" data-hint>Klik op de deur om binnen te kijken</span>
      <span class="block font-display text-base leading-tight font-bold sm:text-lg md:text-xl" data-titel>{plekken[0].label}</span>
    </p>
    <button type="button" class="btn btn-wit pointer-events-auto shrink-0 max-sm:px-4 max-sm:py-2.5" data-kijk-binnen>Kijk binnen</button>
    <div class="pointer-events-auto flex shrink-0 gap-2">
      <button type="button" class="kant" data-draai="links" hidden>
        <Fragment set:html={pijl('M15 5l-7 7 7 7')} /><span class="sr-only">Linksaf</span>
      </button>
      <button type="button" class="kant" data-draai="rechts" hidden>
        <Fragment set:html={pijl('M9 5l7 7-7 7')} /><span class="sr-only">Rechtsaf</span>
      </button>
    </div>
  </div>
</div>
<script type="application/json" data-rondloop-namen set:html={JSON.stringify(naam)} />

<style>
  .rondloop { container-type: size; user-select: none; -webkit-user-select: none; }
  .plek { position: absolute; inset: 0; opacity: 0; visibility: hidden;
    transition: opacity .55s ease, transform .75s cubic-bezier(.3,.6,.2,1), visibility 0s linear .75s; }
  .plek[data-actief] { opacity: 1; visibility: visible; transition: opacity .55s ease, transform .75s cubic-bezier(.3,.6,.2,1), visibility 0s; }
  /* De foto (4:3) vult het kader zoals object-cover, zodat de punten in procenten van de foto kloppen. */
  .vlak { position: absolute; left: 50%; top: 50%; aspect-ratio: 4 / 3; width: max(100cqw, 133.334cqh); transform: translate(-50%, -50%); }
  .punt { position: absolute; display: flex; flex-direction: column; align-items: center; gap: .4rem; transform: translate(-50%, -22px); cursor: pointer; }
  .punt.rechts { align-items: flex-end; transform: translate(calc(-100% + 22px), -22px); }
  .stip { position: relative; width: 44px; height: 44px; flex: none; border-radius: 999px; background: rgba(255,255,255,.95);
    box-shadow: 0 2px 10px rgba(20,32,29,.35); }
  .stip::before { content: ""; position: absolute; inset: 14px; border-radius: 999px; background: var(--color-groen); }
  .stip::after { content: ""; position: absolute; inset: -6px; border-radius: 999px; border: 2px solid rgba(255,255,255,.9); animation: puls 1.8s ease-out infinite; }
  @keyframes puls { from { transform: scale(.8); opacity: 1; } to { transform: scale(1.35); opacity: 0; } }
  .tekst { border-radius: 999px; background: rgba(255,255,255,.95); color: var(--color-ink); padding: .35rem .8rem; font-size: var(--text-sm);
    font-weight: 600; white-space: nowrap; box-shadow: 0 2px 10px rgba(20,32,29,.25); }
  .punt:hover .stip::before { background: var(--color-groen-diep); }
  .kant { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    background: rgba(255,255,255,.92); color: var(--color-ink); box-shadow: var(--shadow-zacht); cursor: pointer; }
  @media (min-width: 640px) { .kant { width: 3rem; height: 3rem; } }
  .kant:hover, .pil:hover { background: var(--color-wit); }
  .pil { display: inline-flex; align-items: center; gap: .25rem; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--color-ink);
    padding: .4rem .9rem .4rem .7rem; font-size: var(--text-sm); font-weight: 600; box-shadow: var(--shadow-zacht); cursor: pointer; }
  [hidden] { display: none !important; }
</style>

<script>
  type Stap = 'zoom' | 'links' | 'rechts' | 'terug';
  const UIT: Record<Stap, string> = { zoom: 'scale(1.9)', rechts: 'translateX(-16%)', links: 'translateX(16%)', terug: 'scale(.85)' };
  const IN: Record<Stap, string> = { zoom: 'scale(1.12)', rechts: 'translateX(16%)', links: 'translateX(-16%)', terug: 'scale(1.3)' };

  for (const kader of document.querySelectorAll<HTMLElement>('[data-rondloop]')) {
    const namen: Record<string, string> = JSON.parse(kader.nextElementSibling?.textContent ?? '{}');
    const plekken = new Map([...kader.querySelectorAll<HTMLElement>('[data-plek]')].map((el) => [el.dataset.plek!, el]));
    const $ = <T extends HTMLElement>(s: string) => kader.querySelector<T>(s)!;
    const links = $('[data-draai="links"]');
    const rechts = $('[data-draai="rechts"]');
    const terug = $('[data-terug]');
    const buiten = $('[data-buiten]');
    const kijkBinnen = $('[data-kijk-binnen]');
    const hint = $('[data-hint]');
    const titel = $('[data-titel]');
    const eerste = [...plekken.keys()][0];
    let huidig = eerste;
    let geschiedenis: string[] = [];
    let bezig = false;

    // De overige foto's pas ophalen bij de eerste aanraking, zodat de pagina licht blijft.
    let geladen = false;
    const laadAlles = () => {
      if (geladen) return;
      geladen = true;
      for (const el of plekken.values()) el.hidden = false;
    };
    kader.addEventListener('pointerenter', laadAlles, { once: true });
    kader.addEventListener('focusin', laadAlles, { once: true });
    kader.addEventListener('touchstart', laadAlles, { once: true, passive: true });

    const werkBij = () => {
      const el = plekken.get(huidig)!;
      const opGevel = huidig === eerste;
      links.hidden = !el.dataset.links;
      rechts.hidden = !el.dataset.rechts;
      if (el.dataset.links) links.setAttribute('aria-label', `Linksaf: ${namen[el.dataset.links]}`);
      if (el.dataset.rechts) rechts.setAttribute('aria-label', `Rechtsaf: ${namen[el.dataset.rechts]}`);
      terug.hidden = geschiedenis.length === 0 || opGevel;
      buiten.hidden = opGevel;
      kijkBinnen.hidden = !opGevel;
      titel.textContent = el.dataset.label!;
      hint.textContent = opGevel ? 'Klik op de deur om binnen te kijken'
        : el.querySelector('[data-naar]') ? 'Klik op een punt om verder te lopen' : 'Draai met de pijlen links en rechts';
    };

    const ga = (naar: string, stap: Stap, via?: HTMLElement) => {
      if (bezig || naar === huidig || !plekken.has(naar)) return;
      laadAlles();
      bezig = true;
      const oud = plekken.get(huidig)!;
      const nieuw = plekken.get(naar)!;
      // Inzoomen gebeurt richting het aangeklikte punt.
      if (via) {
        const k = kader.getBoundingClientRect();
        const p = via.querySelector('.stip')!.getBoundingClientRect();
        oud.style.transformOrigin = `${p.left + p.width / 2 - k.left}px ${p.top + p.height / 2 - k.top}px`;
      } else oud.style.transformOrigin = '';
      oud.style.transform = UIT[stap];
      oud.removeAttribute('data-actief');
      oud.setAttribute('aria-hidden', 'true');
      nieuw.style.transition = 'none';
      nieuw.style.transformOrigin = '';
      nieuw.style.transform = IN[stap];
      nieuw.getBoundingClientRect();
      nieuw.style.transition = '';
      nieuw.style.transform = '';
      nieuw.setAttribute('data-actief', '');
      nieuw.removeAttribute('aria-hidden');
      huidig = naar;
      werkBij();
      setTimeout(() => { oud.style.transform = ''; oud.style.transformOrigin = ''; bezig = false; }, 760);
    };

    const vooruit = (naar: string, stap: Stap, via?: HTMLElement) => {
      if (bezig) return;
      geschiedenis.push(huidig);
      ga(naar, stap, via);
    };

    for (const knop of kader.querySelectorAll<HTMLElement>('[data-naar]')) {
      knop.addEventListener('click', () => vooruit(knop.dataset.naar!, 'zoom', knop));
    }
    kijkBinnen.addEventListener('click', () => {
      const deur = plekken.get(eerste)!.querySelector<HTMLElement>('[data-naar]')!;
      vooruit(deur.dataset.naar!, 'zoom', deur);
    });
    const draai = (kant: 'links' | 'rechts') => {
      const naar = plekken.get(huidig)!.dataset[kant];
      if (naar) vooruit(naar, kant);
    };
    links.addEventListener('click', () => draai('links'));
    rechts.addEventListener('click', () => draai('rechts'));
    terug.addEventListener('click', () => {
      const vorige = geschiedenis.pop();
      if (vorige) ga(vorige, 'terug');
    });
    buiten.addEventListener('click', () => {
      geschiedenis = [];
      ga(eerste, 'terug');
      kijkBinnen.focus();
    });
    kader.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); draai('links'); }
      if (e.key === 'ArrowRight') { e.preventDefault(); draai('rechts'); }
    });
    werkBij();
  }
</script>
