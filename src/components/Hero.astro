---
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url } from '../data/site';
import hero from '../assets/hero.jpg';
---
<!-- Brede terrasfoto onder een groene overlay; de gestreepte doekbaan eronder verwijst naar de valk van een zonnescherm. -->
<section class="relative overflow-hidden bg-groen text-wit">
  <div class="absolute inset-0"><Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras met tafel en ligbedden" hero sizes="100vw" /></div>
  <div aria-hidden="true" class="absolute inset-0 bg-groen-donker/80 lg:bg-transparent lg:bg-gradient-to-r lg:from-groen-donker lg:via-groen-donker/85 lg:to-groen-donker/10"></div>
  <div class="wrap relative py-16 lg:py-28">
    <div class="max-w-2xl">
      <p class="kicker text-mint">Zonwering en rolluiken, Ridderkerk</p>
      <h1 class="mt-4 text-4xl">Zonwering op maat, gemonteerd door onze eigen monteurs</h1>
      <p class="mt-6 max-w-xl text-lg text-wit/90">Buiten- en binnenzonwering voor woningen en bedrijven. Bijna alles assembleren we zelf aan de Noordenweg. Kom kijken in de showroom of vraag een offerte aan, dan komen we bij u inmeten.</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={url('#offerte')} class="btn btn-roest">Offerte aanvragen</a>
        <a href={url('#producten')} class="font-display font-semibold underline decoration-mint decoration-2 underline-offset-[6px]">Bekijk de producten</a>
      </div>
      <dl class="mt-10 grid max-w-xl grid-cols-1 gap-4 border-t border-wit/25 pt-6 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-wit/80">Showroom</dt>
          <dd class="font-semibold" data-vandaag>Di t/m vr <span class="whitespace-nowrap tabular-nums">8.30 tot 16.30</span> uur</dd>
        </div>
        <div>
          <dt class="text-wit/80">Klanten op Google</dt>
          <dd class="flex flex-wrap items-center gap-x-2 font-semibold"><Sterren /> <span><span class="tabular-nums">{site.google.score}</span> uit 5, {site.google.aantal} reviews</span></dd>
        </div>
      </dl>
    </div>
  </div>
  <div class="baan relative h-3" aria-hidden="true"></div>
</section>
