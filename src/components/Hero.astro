---
// Hero: de foto over de volle breedte, de kop groot en wit onderin, de feiten als witte kaart rechts.
// De navigatie zweeft over de foto (de sectie schuift onder de header door).
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url } from '../data/site';
import hero from '../assets/hero.jpg';
---
<section class="relative -mt-[4.75rem] flex min-h-[min(38rem,78svh)] flex-col justify-end bg-groen pt-[4.75rem] text-wit lg:-mt-[5.25rem] lg:min-h-[min(52rem,92svh)] lg:pt-[5.25rem]">
  <div class="absolute inset-0"><Foto src={hero} alt="Antracietgrijs knikarmscherm met licht doek boven een terras met eettafel aan een bakstenen woning" hero sizes="100vw" class="object-[50%_45%]" /></div>
  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/10"></div>
  <div class="wrap relative grid gap-6 pb-8 pt-16 lg:grid-cols-12 lg:gap-10 lg:pb-16 lg:pt-24 lg:items-end">
    <div class="lg:col-span-8">
      <p class="kicker text-wit/80">Zonweringsbedrijf Noordenweg, Ridderkerk</p>
      <h1 class="mt-5 max-w-[11ch] text-4xl text-wit lg:max-w-[14ch]">Zonwering en rolluiken op maat.</h1>
      <p class="mt-5 max-w-xl text-base text-wit/90 sm:text-lg lg:text-xl">Buiten- en binnenzonwering, rolluiken, garagedeuren en terrasoverkappingen. Advies in onze showroom, inmeten bij u thuis en montage door onze eigen monteurs.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={url('#offerte')} class="btn btn-wit">Offerte aanvragen</a>
        <a href={url('#producten')} class="btn btn-glas">Bekijk producten</a>
      </div>
    </div>
    <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-wit/90 lg:col-span-4 lg:flex-col lg:items-end lg:gap-y-2 lg:text-right">
      <li><span class="text-wit/70">Showroom</span> <strong class="font-display" data-vandaag>di t/m vr 8.30 tot 16.30</strong></li>
      <li><a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 no-underline hover:underline"><Sterren /> <strong class="font-display tabular-nums">{site.google.score}</strong> op Google<span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>
      <li><a href={site.telHref} class="font-display text-xl font-bold tabular-nums no-underline hover:underline">{site.tel}</a></li>
    </ul>
  </div>
</section>
