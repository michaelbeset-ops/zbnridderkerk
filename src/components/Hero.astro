---
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url } from '../data/site';
import hero from '../assets/hero.jpg';
---
<section class="relative bg-linnen">
  <div class="wrap grid gap-8 pb-12 pt-0 lg:grid-cols-12 lg:gap-8 lg:py-0">
    <div class="lg:order-none lg:col-span-6 lg:py-24 xl:py-28">
      <p class="kicker text-oker-ink">Zonwering en rolluiken uit Ridderkerk</p>
      <h1 class="mt-5 text-4xl text-groen">Zonwering op maat, gemonteerd door onze eigen monteurs</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-zacht">Buiten- en binnenzonwering voor woningen en bedrijven. Bijna alles assembleren we zelf aan de Noordenweg. Kom kijken in de showroom of vraag een offerte aan, dan komen we bij u inmeten.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
        <a href={url('#producten')} class="btn btn-lijn text-groen">Bekijk de producten</a>
      </div>
      <dl class="mt-10 grid max-w-xl gap-4 border-t border-lijn pt-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-ink-zacht">Showroom</dt>
          <dd class="mt-0.5 font-semibold" data-vandaag>Di t/m vr <span class="whitespace-nowrap tabular-nums">8.30 tot 16.30</span> uur</dd>
        </div>
        <div>
          <dt class="text-sm text-ink-zacht">Klanten op Google</dt>
          <dd class="mt-0.5 flex flex-wrap items-center gap-x-2 font-semibold"><Sterren /> <span><span class="tabular-nums">{site.google.score}</span> uit 5, {site.google.aantal} reviews</span></dd>
        </div>
      </dl>
    </div>
    <!-- Foto loopt op desktop door tot de rechterrand; de groene valk erboven is de schulprand van een zonnescherm. -->
    <div class="relative order-first -mx-5 aspect-[4/3] md:-mx-10 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:aspect-auto lg:w-[46%]">
      <Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras met tafel en ligbedden" hero sizes="(min-width: 1024px) 46vw, 100vw" />
      <div class="absolute inset-x-0 top-0 text-groen" aria-hidden="true"><div class="h-4 bg-groen"></div><div class="valk"></div></div>
    </div>
  </div>
</section>
