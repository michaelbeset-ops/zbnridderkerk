---
// Hero: grote kop met veel wit, daarnaast de foto in een kaart. Dunne lijnen en kruisjes als rasterdetail.
import { Image } from 'astro:assets';
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url } from '../data/site';
import logo from '../assets/logo.png';
import hero from '../assets/hero.jpg';
---
<section class="wrap pt-10 lg:pt-16">
  <div class="raster kruis kruis-onder grid gap-10 py-10 lg:grid-cols-12 lg:gap-x-8 lg:gap-y-0 lg:py-14">
    <div class="lg:col-span-7 lg:pr-6">
      <div class="flex items-center gap-4">
        <Image src={logo} alt="" width={176} height={120} loading="eager" class="hidden h-16 w-auto lg:block" />
        <p class="kicker text-ink-zacht">Zonweringsbedrijf Noordenweg, Ridderkerk</p>
      </div>
      <h1 class="mt-8 text-4xl">Zonwering en rolluiken op maat, uit Ridderkerk.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-zacht lg:text-xl">Buiten- en binnenzonwering, rolluiken, garagedeuren en terrasoverkappingen. Bijna alles assembleren we zelf en onze eigen monteurs plaatsen het.</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
        <a href={url('#producten')} class="btn btn-wit">Bekijk producten</a>
      </div>
    </div>
    <div class="lg:col-span-5 lg:row-span-2">
      <div class="relative aspect-[4/3] overflow-hidden rounded-xl shadow-kaart lg:aspect-[4/5]">
        <Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras met tafel en ligbedden" hero sizes="(min-width: 1024px) 520px, 100vw" />
        <!-- Klein label op de foto, zoals een bijschrift. -->
        <p class="absolute bottom-4 left-4 rounded-pill bg-wit/95 px-3.5 py-1.5 text-xs font-medium shadow-zacht">Knikarmscherm, elektrisch met verlichting</p>
      </div>
    </div>
    <div class="lg:col-span-7 lg:self-end lg:pr-6">
      <dl class="flex flex-wrap gap-x-10 gap-y-4 border-t border-lijn pt-6 text-sm lg:mt-10">
        <div>
          <dt class="text-ink-zacht">Liever bellen?</dt>
          <dd class="mt-0.5"><a href={site.telHref} class="font-display text-lg font-semibold tabular-nums no-underline hover:underline">{site.tel}</a></dd>
        </div>
        <div>
          <dt class="text-ink-zacht">Showroom</dt>
          <dd class="mt-0.5 font-semibold" data-vandaag>Di t/m vr <span class="whitespace-nowrap tabular-nums">8.30 tot 16.30</span> uur</dd>
        </div>
        <div>
          <dt class="text-ink-zacht">Klanten op Google</dt>
          <dd class="mt-0.5"><a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold no-underline hover:underline"><Sterren /> <span class="tabular-nums">{site.google.score}</span> uit 5<span class="sr-only"> (opent Google in een nieuw tabblad)</span></a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>
