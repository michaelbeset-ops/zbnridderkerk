---
// Hero: de foto over de volle breedte, de kop groot en wit onderin, de feiten als witte kaart rechts.
// De navigatie zweeft over de foto (de sectie schuift onder de header door).
import Foto from './Foto.astro';
import Sterren from './Sterren.astro';
import { site, url, producten } from '../data/site';
import hero from '../assets/hero.jpg';
---
<section class="relative -mt-[5.5rem] flex min-h-[min(46rem,92svh)] flex-col justify-end bg-groen pt-[5.5rem] text-wit lg:-mt-[6rem] lg:min-h-[min(52rem,92svh)] lg:pt-[6rem]">
  <div class="absolute inset-0"><Foto src={hero} alt="Groot uitgeschoven knikarmscherm met verlichting boven een terras met tafel en ligbedden" hero sizes="100vw" class="object-[50%_35%]" /></div>
  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/10"></div>
  <div class="wrap relative grid gap-8 pb-10 pt-24 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-16">
    <div class="lg:col-span-8">
      <p class="kicker text-wit/80">Zonweringsbedrijf Noordenweg, Ridderkerk</p>
      <h1 class="mt-5 max-w-[14ch] text-4xl text-wit">Zonwering en rolluiken op maat.</h1>
      <p class="mt-6 max-w-xl text-lg text-wit/90 lg:text-xl">Buiten- en binnenzonwering, rolluiken, garagedeuren en terrasoverkappingen. Bijna alles assembleren we zelf, en onze eigen monteurs plaatsen het.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={url('#offerte')} class="btn btn-wit">Offerte aanvragen</a>
        <a href={url('#producten')} class="btn btn-glas">Bekijk producten</a>
      </div>
    </div>
    <dl class="grid gap-0 divide-y divide-lijn rounded-xl bg-wit text-ink shadow-kaart lg:col-span-4">
      <div class="flex items-center justify-between gap-4 px-5 py-4">
        <dt class="text-sm text-ink-zacht">Showroom</dt>
        <dd class="text-right font-display font-semibold" data-vandaag>Di t/m vr <span class="whitespace-nowrap tabular-nums">8.30 tot 16.30</span></dd>
      </div>
      <div class="flex items-center justify-between gap-4 px-5 py-4">
        <dt class="text-sm text-ink-zacht">Google</dt>
        <dd><a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-display font-semibold no-underline hover:underline"><Sterren /> <span class="tabular-nums">{site.google.score}</span> uit 5<span class="sr-only"> (opent Google in een nieuw tabblad)</span></a></dd>
      </div>
      <div class="flex items-center justify-between gap-4 px-5 py-4">
        <dt class="text-sm text-ink-zacht">Bel ons</dt>
        <dd><a href={site.telHref} class="font-display text-lg font-bold tabular-nums no-underline hover:underline">{site.tel}</a></dd>
      </div>
    </dl>
  </div>
</section>
<!-- Snelkeuze onder de hero: alle producten in een rij, op mobiel swipebaar. -->
<nav aria-label="Snel naar een product" class="border-b border-lijn bg-wit">
  <ul class="slider wrap py-4 md:flex-wrap md:gap-2 md:overflow-visible">
    {producten.map((p) => <li><a href={url(`producten/${p.slug}/`)} class="btn btn-wit !px-4 !py-2 text-sm !shadow-none ring-1 ring-lijn hover:ring-groen">{p.naam}</a></li>)}
  </ul>
</nav>
