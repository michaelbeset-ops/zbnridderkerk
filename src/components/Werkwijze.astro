---
// Vier stappen met eigen getekende iconen, op desktop naast elkaar met een lijn die bij het laatste icoon stopt,
// op mobiel onder elkaar. Daaronder een foto uit de showroom.
import Foto from './Foto.astro';
import toonbank from '../assets/showroom/3-toonbank.jpg';
import { site, url } from '../data/site';
const stappen = [
  { kop: 'Advies in de showroom', tekst: 'Kom langs aan de Noordenweg of vraag een offerte aan via de website. We bespreken wat u zoekt en wat er past.',
    icoon: 'M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6' },
  { kop: 'Inmeten bij u thuis', tekst: 'We komen langs, meten alles nauwkeurig in en bekijken de gevel of het kozijn. Daarna ontvangt u een definitieve offerte.',
    icoon: 'M3 8h18v8H3zM7 8v3M11 8v4M15 8v3M19 8v4' },
  { kop: 'Op maat besteld', tekst: 'Na uw akkoord bestellen we alles op de ingemeten maten en plannen we samen de montage.',
    icoon: 'M4 7h16v13H4zM4 7l2-3h12l2 3M9 11h6' },
  { kop: 'Montage door eigen monteurs', tekst: 'Onze eigen monteurs plaatsen het product volgens de voorschriften van de fabrikant en leggen uit hoe het werkt.',
    icoon: 'M14.5 4.5a4 4 0 0 0-5 5L3 16v5h5l6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z' },
];
---
<section id="werkwijze" class="scroll-mt-24 bg-ijs py-16 lg:py-24">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker text-ink-zacht">Hoe werken wij</p>
        <h2 class="mt-3 text-3xl">Van eerste gesprek tot montage, in eigen hand.</h2>
      </div>
      <p class="text-lg text-ink-zacht lg:col-span-5 lg:pb-1">Advies, inmeten en plaatsen doen we zelf. Zo weet u precies wat u krijgt.</p>
    </div>
    <ol class="relative mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {stappen.map((s, i) => (
        <li class="relative flex gap-5 lg:block">
          <!-- Lijn naar de volgende stap: op mobiel omlaag, op desktop naar rechts. Niet bij de laatste stap. -->
          {i < stappen.length - 1 && <span aria-hidden="true" class="absolute left-8 top-16 h-[calc(100%+2.5rem-4rem)] w-px bg-groen/30 md:hidden lg:left-[4.5rem] lg:top-8 lg:block lg:h-px lg:w-[calc(100%-4.5rem+2rem)]"></span>}
          <div class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-pill bg-wit text-groen shadow-zacht ring-1 ring-lijn">
            <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={s.icoon}/></svg>
            <span class="absolute -right-1 -top-1 flex h-6 w-6 items-center justify-center rounded-pill bg-groen font-display text-xs font-bold text-wit">{i + 1}</span>
          </div>
          <div class="lg:mt-6">
            <h3 class="text-lg"><span class="sr-only">Stap {i + 1}: </span>{s.kop}</h3>
            <p class="mt-2 text-sm text-ink-zacht">{s.tekst}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-14 grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="aspect-[16/9] overflow-hidden rounded-xl lg:order-last lg:col-span-6 lg:aspect-[3/2]"><Foto src={toonbank} alt="Showroom van ZBN met de toonbank van steigerhout voor een wand met rolluiken en screens" sizes="(min-width: 1024px) 700px, 100vw" /></div>
      <div class="lg:col-span-5">
        <h3 class="text-2xl">Geen webshop, maar een vakbedrijf.</h3>
        <p class="mt-3 text-ink-zacht">ZBN zit aan de Noordenweg in Ridderkerk. U krijgt advies in de showroom, we meten bij u thuis in en onze eigen monteurs plaatsen alles.</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
          <a href={site.telHref} class="btn btn-wit">Bel <span class="tabular-nums">{site.tel}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
