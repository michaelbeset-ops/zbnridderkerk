---
import { site, url } from '../data/site';
const stappen = [
  { kop: 'Showroom of aanvraag', tekst: 'Kom langs in de showroom aan de Noordenweg om producten en stalen te bekijken. Of vraag een offerte aan via de site, dan nemen wij contact met u op.' },
  { kop: 'Afspraak inmeten', tekst: 'We komen bij u thuis of op het bedrijf. We meten alles in, bekijken de gevel of het kozijn en adviseren wat er past.' },
  { kop: 'Definitieve offerte', tekst: 'Op basis van de maten en uw keuzes krijgt u een definitieve offerte, zonder verrassingen achteraf.' },
  { kop: 'Montage', tekst: 'Onze eigen monteurs plaatsen het product op de voorgeschreven manier en leggen uit hoe het werkt. Ook voor reparatie en onderhoud kunt u daarna bij ons terecht.' },
];
---
<section id="werkwijze" class="scroll-mt-20 bg-groen py-16 text-wit lg:py-24">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <h2 class="text-3xl lg:col-span-5">Hoe werken wij?</h2>
      <p class="text-lg text-wit/85 lg:col-span-6 lg:col-start-7 lg:pt-2">Van het eerste gesprek tot de montage houden we het in eigen hand. In vier stappen.</p>
    </div>
    <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {stappen.map((s, i) => (
        <li class="relative border-t-2 border-mint/40 pt-5">
          <span class="absolute -top-[2px] left-0 h-[2px] w-12 bg-roest" aria-hidden="true"></span>
          <p class="font-display text-cijfer font-bold leading-none tracking-[-0.05em] text-mint" aria-hidden="true">{i + 1}</p>
          <h3 class="mt-3 text-xl"><span class="sr-only">Stap {i + 1}: </span>{s.kop}</h3>
          <p class="mt-3 text-wit/85">{s.tekst}</p>
        </li>
      ))}
    </ol>
    <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={url('#offerte')} class="btn btn-roest">Offerte aanvragen</a>
      <a href={site.telHref} class="font-display font-semibold underline decoration-mint decoration-2 underline-offset-[6px]">Of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
    </div>
  </div>
</section>
