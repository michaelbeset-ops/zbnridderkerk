---
// Vier stappen met eigen getekende iconen. Op desktop naast elkaar met een verbindende lijn, op mobiel onder elkaar.
import { site, url } from '../data/site';
const stappen = [
  { kop: 'Showroom of aanvraag', tekst: 'Kom langs in de showroom aan de Noordenweg, of vraag een offerte aan via de website. Dan nemen wij contact met u op.',
    icoon: 'M3 10l9-6 9 6v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM9 21v-6h6v6' },
  { kop: 'Afspraak inmeten', tekst: 'We komen bij u thuis of op het bedrijf, meten alles in en adviseren wat past bij de gevel of het kozijn.',
    icoon: 'M3 7h18M3 17h18M7 7v3M12 7v5M17 7v3M7 17v-3M12 17v-5M17 17v-3' },
  { kop: 'Definitieve offerte', tekst: 'Op basis van de maten en uw keuzes ontvangt u een definitieve offerte, zonder verrassingen achteraf.',
    icoon: 'M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M9 13h6M9 17h6' },
  { kop: 'Montage', tekst: 'Onze eigen monteurs plaatsen het product op de voorgeschreven manier en leggen uit hoe het werkt.',
    icoon: 'M14.5 4.5a4 4 0 0 0-5 5L3 16v5h5l6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z' },
];
---
<section id="werkwijze" class="scroll-mt-24 bg-ijs py-16 lg:py-24">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker text-ink-zacht">Hoe werken wij</p>
        <h2 class="mt-3 text-3xl">Van eerste gesprek tot montage, in vier stappen.</h2>
      </div>
      <p class="text-lg text-ink-zacht lg:col-span-5 lg:pb-1">We houden het in eigen hand: advies, inmeten, maken en plaatsen. Zo weet u wat u krijgt.</p>
    </div>
    <ol class="relative mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- De verbindende lijn loopt op desktop door de iconen heen. -->
      <li aria-hidden="true" class="absolute left-7 top-0 hidden h-full w-px bg-lijn md:block lg:left-0 lg:top-7 lg:h-px lg:w-full"></li>
      {stappen.map((s, i) => (
        <li class="relative flex gap-5 lg:block">
          <div class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-pill bg-wit text-groen shadow-zacht ring-1 ring-lijn">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icoon}/></svg>
            <span class="absolute -right-1.5 -top-1.5 flex h-6 w-6 items-center justify-center rounded-pill bg-groen font-display text-xs font-bold text-wit">{i + 1}</span>
          </div>
          <div class="lg:mt-6">
            <h3 class="text-xl"><span class="sr-only">Stap {i + 1}: </span>{s.kop}</h3>
            <p class="mt-2 text-ink-zacht">{s.tekst}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-12 flex flex-wrap items-center gap-3">
      <a href={url('#offerte')} class="btn btn-groen">Offerte aanvragen</a>
      <a href={site.telHref} class="btn btn-wit">Bel <span class="tabular-nums">{site.tel}</span></a>
    </div>
  </div>
</section>
